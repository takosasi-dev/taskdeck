<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- チップとバッジ（UI 設計書 6.4）。担当: 波1-C -->
    <Style x:Key="ChipBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="MinHeight" Value="20" />
    </Style>

    <Style x:Key="CountBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinWidth" Value="{StaticResource BadgeHeight}" />
        <Setter Property="Height" Value="{StaticResource BadgeHeight}" />
        <Setter Property="Padding" Value="6,0" />
    </Style>

    <!-- 一覧の行に出す小さいチップ（プロジェクト名。左にプロジェクト色の丸） -->
    <Style x:Key="RowChipBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <!-- 選択中の行は地が色づくので、チップは内容面の色にして浮かせる（モックアップどおり） -->
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceContentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RowChipTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBaseStyle}">
        <Setter Property="FontSize" Value="{StaticResource TypeLabelSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="RowProjectDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 行のタグ（#仕事）。チップの地は敷かず、文字だけで出す -->
    <Style x:Key="RowTagTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RowChipTextStyle}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxWidth" Value="160" />
    </Style>

    <!-- 詳細ペインのタグチップ（× で外す） -->
    <Style x:Key="TagChipBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}" />
        <Setter Property="Padding" Value="8,1,2,1" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="MinHeight" Value="24" />
    </Style>

    <!-- 検索結果の「出どころ」（今日／予定／完了済み） -->
    <Style x:Key="RowSourceTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBaseStyle}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
</ResourceDictionary>
