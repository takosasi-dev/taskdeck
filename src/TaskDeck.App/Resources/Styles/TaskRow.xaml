<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        タスク行（UI 設計書 6.1）。担当: 波1-C。
        行の中身（DataTemplate）は Views/Main/TaskListView.xaml にある（イベントハンドラを付けるため）。
        ここには入れ物（ListBoxItem）と、行・一覧の見出しで使う文字とボタンのスタイルを置く。
    -->

    <Style x:Key="TaskRowContainerStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <!-- 右の 8px はスクロールバーの通り道（TaskListView 参照） -->
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualRowStyle}" />
        <!-- 読み上げ: 「未完了、優先度高、会議資料まとめる、今日15時」 -->
        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusRow}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource SurfaceSelectedStrokeBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsInTrash}" Value="True">
                            <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFading}" Value="True">
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                        <!-- ドラッグ中（UI 設計書 15.5）: 掴んだ行は元の位置に 40% で残し、子にする先の行はアクセントの枠で囲む -->
                        <DataTrigger Binding="{Binding IsDragging}" Value="True">
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        中身を左に寄せる文字ボタン（一覧の入力行・ポップアップの選択肢・詳細ペインの行）。
        Buttons.xaml の TextButtonStyle は中身を中央に置く作りなので、左寄せが要る場所はこちらを使う。
    -->
    <Style x:Key="LeftTextButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySmallSize}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualRowStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusRow}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ポップアップの選択肢（左に選択中の印、右に文字） -->
    <Style x:Key="MenuChoiceButtonStyle" TargetType="Button" BasedOn="{StaticResource LeftTextButtonStyle}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <!-- 選択中の印（✓）。DataContext の IsCurrent で出す -->
    <Style x:Key="MenuCheckMarkStyle" TargetType="Path" BasedOn="{StaticResource IconPathStyle}">
        <Setter Property="Stroke" Value="{DynamicResource AccentDefaultBrush}" />
        <Setter Property="Data" Value="{StaticResource IconCheck}" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Visibility" Value="Hidden" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 一覧の見出しに並べるボタン（高さ 30。並び替え・絞り込み・フォーカス） -->
    <Style x:Key="ListToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
        <Setter Property="Height" Value="{StaticResource ToolbarButtonHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <!-- 完了済みビューの期間（今日・7日・30日・すべて）。選んでいるものに地を敷く -->
    <Style x:Key="PeriodButtonStyle" TargetType="Button" BasedOn="{StaticResource LeftTextButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ToolbarButtonHeight}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 一覧の末尾の入力欄。フォーカスが無いときは枠も地も出さず、「＋ タスクを追加」の行に見せる -->
    <Style x:Key="AddRowTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
        <Setter Property="Height" Value="34" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="34,0,8,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="IBeam" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceContentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource StrokeControlBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- グループ見出し・入力行の入れ物（ホバーも選択も出さない） -->
    <Style x:Key="PlainRowContainerStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- タイトル: 1行で省略。選択中は少し太く、完了は取り消し線、サブタスクは 13px -->
    <Style x:Key="RowTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBodyStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSubtask}" Value="True">
                <Setter Property="FontSize" Value="{StaticResource TypeBodySmallSize}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="FontWeight" Value="Medium" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsClosed}" Value="True">
                <Setter Property="TextDecorations" Value="Strikethrough" />
                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SubtaskTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource RowTitleStyle}">
        <Setter Property="FontSize" Value="{StaticResource TypeBodySmallSize}" />
    </Style>

    <!-- 行のチェック（17px、サブタスクは 15px）。1つのチェックを大きさだけ変えて使う（行ごとに部品を増やさない） -->
    <Style x:Key="RowCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource TaskCheckBoxStyle}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSubtask}" Value="True">
                <Setter Property="Width" Value="{StaticResource SubtaskCheckBoxSize}" />
                <Setter Property="Height" Value="{StaticResource SubtaskCheckBoxSize}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 必要な行だけ中身を作る入れ物（名前の変更欄・ゴミ箱の操作）。ふだんは空で、行ごとの部品を増やさない -->
    <Style x:Key="LazyPartStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 優先度の ! 記号（なしでも 22px 空ける） -->
    <Style x:Key="RowPriorityStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBaseStyle}">
        <Setter Property="Width" Value="{StaticResource PriorityColumnWidth}" />
        <Setter Property="FontSize" Value="{StaticResource TypeCaptionSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Priority}" Value="Urgent">
                <Setter Property="Foreground" Value="{DynamicResource PriorityUrgentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Priority}" Value="High">
                <Setter Property="Foreground" Value="{DynamicResource PriorityHighBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Priority}" Value="Medium">
                <Setter Property="Foreground" Value="{DynamicResource PriorityMediumBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Priority}" Value="Low">
                <Setter Property="Foreground" Value="{DynamicResource PriorityLowBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 期限欄（58px・右寄せ・等幅数字） -->
    <Style x:Key="RowDueStyle" TargetType="TextBlock" BasedOn="{StaticResource TabularCaptionStyle}">
        <Setter Property="Width" Value="{StaticResource DueColumnWidth}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDueStrong}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource StateOverdueBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- グループ見出し -->
    <Style x:Key="GroupHeaderTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TextCaptionStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource StateOverdueBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GroupHeaderCountStyle" TargetType="TextBlock" BasedOn="{StaticResource TabularCaptionStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,8,0" />
    </Style>

    <Style x:Key="GroupHeaderLineStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource StrokeSubtleBrush}" />
    </Style>

    <!-- 読み込み中のスケルトン（UI 設計書 15.3） -->
    <Style x:Key="SkeletonBlockStyle" TargetType="Border">
        <Setter Property="Height" Value="11" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{DynamicResource StrokeSubtleBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
