<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        浮かせる面（ポップアップ・パレット・トースト）。担当: 波1-D。
        影は DropShadowEffect を使わず、外側の余白と半透明の Border を重ねて描く（CLAUDE.md 1.3）。
        Popup の中身は Popup 自身のウィンドウに描かれるので、外側に余白を取れば影を置く場所ができる。
        使い方:
          <Popup AllowsTransparency="True" StaysOpen="False" ...>   ← 余白を透明にするため AllowsTransparency は必須
            <Border Style="{StaticResource PopupShadowStyle}">
              <Border Style="{StaticResource PopupSurfaceStyle}" Width="...">中身</Border>
            </Border>
          </Popup>
        面の幅（ピッカーの 296・186 など）は内側の PopupSurfaceStyle の Border に付ける。外側は余白（左右10・上8・下14）の分だけ大きい。
        影は上より下を厚くして、光が上から当たっているように見せる（モックアップの 0 8px 24px の代わり）。
    -->
    <Style x:Key="PopupShadowStyle" TargetType="Border">
        <Setter Property="Margin" Value="10,8,10,14" />
        <Setter Property="Padding" Value="1,1,1,3" />
        <Setter Property="Background" Value="{DynamicResource PopupShadowBrush}" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="PopupSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceContentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeControlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusWindow}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ポップアップの見出し（「期限を設定」）と区切り -->
    <Style x:Key="PopupHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBodySmallStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="14,12,14,10" />
    </Style>

    <Style x:Key="PopupSeparatorStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource StrokeSubtleBrush}" />
    </Style>

    <!-- ポップアップ下部の案内（「Ctrl+1 〜 Ctrl+4 で直接指定」） -->
    <Style x:Key="PopupHintStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBaseStyle}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="Margin" Value="12,6,12,8" />
    </Style>
</ResourceDictionary>
