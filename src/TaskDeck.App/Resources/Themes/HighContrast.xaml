<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        ハイコントラスト（UI 設計書 8章）。Windows のハイコントラストが有効なとき、ThemeService が
        Light.xaml / Dark.xaml の代わりにこれを差し込む。Light.xaml と同じキーをすべて持つ
        （tests/TaskDeck.Tests/App/Appearance/ThemeDictionaryTests が確かめる）。

        値はすべて SystemColors から取る（ユーザーが選んだハイコントラストの配色に従う）。
        - Brush は DynamicResource（配色を変えたその場で追従する）
        - Color は x:Static（Color は DependencyObject ではないため。配色が変わったら ThemeService がこの辞書を読み直す）
        - 文字は WindowText、地は Window、選択とアクセントは Highlight / HighlightText、無効は GrayText、
          ボタンは Control（ButtonFace）/ ControlText（ButtonText）、リンクは HotTrack。
        - 色で区別していたもの（優先度・期限切れ・ヒートマップ）は WindowText に潰す。
          ハイコントラストでは色数が足りないため、記号・アイコン・数字の併記が唯一の手がかりになる。
        - 影（PopupShadow）は描かない。浮かせる面の境界は Stroke.Control（WindowText）の枠が担う。
    -->

    <!-- サーフェスと境界 -->
    <x:Static x:Key="SurfaceWindowColor" Member="SystemColors.WindowColor" />
    <x:Static x:Key="SurfaceContentColor" Member="SystemColors.WindowColor" />
    <x:Static x:Key="SurfaceSubtleColor" Member="SystemColors.WindowColor" />
    <x:Static x:Key="SurfaceHoverColor" Member="SystemColors.WindowColor" />
    <x:Static x:Key="SurfaceSelectedColor" Member="SystemColors.WindowColor" />
    <x:Static x:Key="SurfaceSelectedStrokeColor" Member="SystemColors.HighlightColor" />
    <x:Static x:Key="StrokeDividerColor" Member="SystemColors.WindowTextColor" />
    <x:Static x:Key="StrokeSubtleColor" Member="SystemColors.GrayTextColor" />
    <x:Static x:Key="StrokeControlColor" Member="SystemColors.WindowTextColor" />
    <x:Static x:Key="StrokeControlStrongColor" Member="SystemColors.WindowTextColor" />

    <!-- テキスト -->
    <x:Static x:Key="TextPrimaryColor" Member="SystemColors.WindowTextColor" />
    <x:Static x:Key="TextSecondaryColor" Member="SystemColors.WindowTextColor" />
    <x:Static x:Key="TextTertiaryColor" Member="SystemColors.WindowTextColor" />
    <x:Static x:Key="TextDisabledColor" Member="SystemColors.GrayTextColor" />
    <x:Static x:Key="TextOnAccentColor" Member="SystemColors.HighlightTextColor" />
    <!-- 破壊的ボタンは地が WindowText（Danger）なので、文字は Window で反転させる -->
    <x:Static x:Key="TextOnDangerColor" Member="SystemColors.WindowColor" />

    <!-- アクセント -->
    <x:Static x:Key="AccentDefaultColor" Member="SystemColors.HighlightColor" />
    <x:Static x:Key="AccentHoverColor" Member="SystemColors.HighlightColor" />
    <x:Static x:Key="AccentPressedColor" Member="SystemColors.HighlightColor" />

    <!-- 状態 -->
    <x:Static x:Key="StateOverdueColor" Member="SystemColors.WindowTextColor" />
    <x:Static x:Key="StateOverdueBgColor" Member="SystemColors.WindowColor" />
    <x:Static x:Key="StateSuccessColor" Member="SystemColors.WindowTextColor" />
    <x:Static x:Key="DangerColor" Member="SystemColors.WindowTextColor" />

    <!-- 優先度（記号 !〜!!!! が唯一の手がかりになる） -->
    <x:Static x:Key="PriorityUrgentColor" Member="SystemColors.WindowTextColor" />
    <x:Static x:Key="PriorityHighColor" Member="SystemColors.WindowTextColor" />
    <x:Static x:Key="PriorityMediumColor" Member="SystemColors.WindowTextColor" />
    <x:Static x:Key="PriorityLowColor" Member="SystemColors.WindowTextColor" />

    <!-- 個別の面（選択中の項目は、地を変えずにアクセントの縦バーと枠で示す） -->
    <x:Static x:Key="NavSelectedColor" Member="SystemColors.WindowColor" />
    <x:Static x:Key="SearchHighlightColor" Member="SystemColors.HighlightColor" />
    <x:Static x:Key="AnchorBandColor" Member="SystemColors.WindowColor" />
    <x:Static x:Key="PastWarnBackgroundColor" Member="SystemColors.WindowColor" />
    <x:Static x:Key="PastWarnForegroundColor" Member="SystemColors.WindowTextColor" />
    <x:Static x:Key="PastWarnStrokeColor" Member="SystemColors.WindowTextColor" />
    <x:Static x:Key="SettingsCardColor" Member="SystemColors.WindowColor" />
    <x:Static x:Key="AttentionDotColor" Member="SystemColors.WindowTextColor" />
    <x:Static x:Key="HeatLevel1Color" Member="SystemColors.GrayTextColor" />
    <x:Static x:Key="HeatLevel2Color" Member="SystemColors.GrayTextColor" />
    <x:Static x:Key="HeatLevel3Color" Member="SystemColors.HighlightColor" />
    <x:Static x:Key="HeatLevel4Color" Member="SystemColors.HighlightColor" />
    <x:Static x:Key="PopupShadowColor" Member="Colors.Transparent" />

    <!-- テーマに関わらず暗い面（ハイコントラストでは他と同じ配色にする） -->
    <x:Static x:Key="ToastBackgroundColor" Member="SystemColors.WindowColor" />
    <x:Static x:Key="ToastForegroundColor" Member="SystemColors.WindowTextColor" />
    <x:Static x:Key="ToastActionColor" Member="SystemColors.HotTrackColor" />
    <x:Static x:Key="BulkDangerColor" Member="SystemColors.WindowTextColor" />
    <x:Static x:Key="SplashBackgroundColor" Member="SystemColors.WindowColor" />
    <x:Static x:Key="FocusRemainingColor" Member="SystemColors.WindowTextColor" />

    <SolidColorBrush x:Key="SurfaceWindowBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="SurfaceContentBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="SurfaceSelectedStrokeBrush" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="StrokeDividerBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="StrokeSubtleBrush" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <SolidColorBrush x:Key="StrokeControlBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="StrokeControlStrongBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
    <SolidColorBrush x:Key="TextOnDangerBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="AccentDefaultBrush" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="StateOverdueBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="StateOverdueBgBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="StateSuccessBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="PriorityUrgentBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="PriorityHighBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="PriorityMediumBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="PriorityLowBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="SearchHighlightBrush" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="AnchorBandBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="PastWarnBackgroundBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="PastWarnForegroundBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="PastWarnStrokeBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="SettingsCardBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="AttentionDotBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="HeatLevel1Brush" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <SolidColorBrush x:Key="HeatLevel2Brush" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <SolidColorBrush x:Key="HeatLevel3Brush" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="HeatLevel4Brush" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="PopupShadowBrush" Color="{StaticResource PopupShadowColor}" />
    <SolidColorBrush x:Key="ToastBackgroundBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="ToastForegroundBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="ToastActionBrush" Color="{DynamicResource {x:Static SystemColors.HotTrackColorKey}}" />
    <SolidColorBrush x:Key="BulkDangerBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="SplashBackgroundBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="FocusRemainingBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />

    <!--
        ===== WPF-UI（4.3.0）のキーの上書き =====
        Light.xaml と同じキー。ハイコントラストでは WPF-UI 自身もハイコントラスト用の辞書に切り替わるが、
        自前の辞書の方が後ろに並んで勝つので、ここでもすべて SystemColors から与える。
    -->
    <x:Static x:Key="ApplicationBackgroundColor" Member="SystemColors.WindowColor" />
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="WindowBackground" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="WindowForeground" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />

    <!-- 面 -->
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="CardBackground" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="FlyoutBackground" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="FlyoutBorderBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="ContextMenuBackground" Color="{DynamicResource {x:Static SystemColors.MenuColorKey}}" />
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="{DynamicResource {x:Static SystemColors.MenuTextColorKey}}" />
    <SolidColorBrush x:Key="ContextMenuForeground" Color="{DynamicResource {x:Static SystemColors.MenuTextColorKey}}" />
    <SolidColorBrush x:Key="ToolTipBackground" Color="{DynamicResource {x:Static SystemColors.InfoColorKey}}" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{DynamicResource {x:Static SystemColors.InfoTextColorKey}}" />
    <SolidColorBrush x:Key="ToolTipForeground" Color="{DynamicResource {x:Static SystemColors.InfoTextColorKey}}" />

    <!-- コントロールの地と枠（ボタンの面は ButtonFace / ButtonText） -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{DynamicResource {x:Static SystemColors.ControlTextColorKey}}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{DynamicResource {x:Static SystemColors.ControlTextColorKey}}" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="{DynamicResource {x:Static SystemColors.ControlTextColorKey}}" />
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="CircleElevationBorderBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />

    <!-- ボタン -->
    <SolidColorBrush x:Key="ButtonBackground" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="ButtonForeground" Color="{DynamicResource {x:Static SystemColors.ControlTextColorKey}}" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{DynamicResource {x:Static SystemColors.ControlTextColorKey}}" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{DynamicResource {x:Static SystemColors.ControlTextColorKey}}" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />

    <!-- 入力欄・ComboBox -->
    <SolidColorBrush x:Key="TextControlBackground" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="TextControlForeground" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="TextControlButtonForeground" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="ComboBoxBackground" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />

    <!-- チェック・ラジオ・トグル -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
    <SolidColorBrush x:Key="CheckBoxForeground" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="RadioButtonForeground" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseFill" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="ToggleSwitchContentForeground" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />

    <!-- 選択・フォーカス・状態 -->
    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="ListViewItemForeground" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="ListViewItemPillFillBrush" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{DynamicResource {x:Static SystemColors.HotTrackColorKey}}" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="{DynamicResource {x:Static SystemColors.HotTrackColorKey}}" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="{DynamicResource {x:Static SystemColors.HotTrackColorKey}}" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="KeyboardFocusBorderColorBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
</ResourceDictionary>
