<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!--
        書体（UI 設計書 3章）。Segoe UI Variable Text、無ければ Segoe UI。日本語は Yu Gothic UI に落ちる（フォントは同梱しない）。
        数字が並ぶ欄は Typography.NumeralAlignment="Tabular" を付ける（TabularText* スタイルに含めてある）。
    -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, Yu Gothic UI</FontFamily>
    <FontFamily x:Key="KeyCapFontFamily">Consolas, Segoe UI</FontFamily>

    <sys:Double x:Key="TypeTitleSize">22</sys:Double>
    <sys:Double x:Key="TypeSubtitleSize">17</sys:Double>
    <sys:Double x:Key="TypeBodySize">14</sys:Double>
    <sys:Double x:Key="TypeBodySmallSize">13</sys:Double>
    <sys:Double x:Key="TypeCaptionSize">12</sys:Double>
    <sys:Double x:Key="TypeLabelSize">11</sys:Double>

    <Style x:Key="TextBaseStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- ビュー見出し（「今日」「2026年 9月」） -->
    <Style x:Key="TextTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBaseStyle}">
        <Setter Property="FontSize" Value="{StaticResource TypeTitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- 詳細ペインのタスクタイトル -->
    <Style x:Key="TextSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBaseStyle}">
        <Setter Property="FontSize" Value="{StaticResource TypeSubtitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- タスクタイトル・サイドバー項目 -->
    <Style x:Key="TextBodyStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBaseStyle}">
        <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
    </Style>
    <!-- サブタスク・詳細ペインの値・ボタン -->
    <Style x:Key="TextBodySmallStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBaseStyle}">
        <Setter Property="FontSize" Value="{StaticResource TypeBodySmallSize}" />
    </Style>
    <!-- 期限・件数・タグ・グループ見出し -->
    <Style x:Key="TextCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBaseStyle}">
        <Setter Property="FontSize" Value="{StaticResource TypeCaptionSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <!-- セクションラベル・ステータスバー -->
    <Style x:Key="TextLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBaseStyle}">
        <Setter Property="FontSize" Value="{StaticResource TypeLabelSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <!-- 数字の欄（期限「15:00」、件数）: 等幅数字で桁をそろえる -->
    <Style x:Key="TabularCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource TextCaptionStyle}">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="TabularBodyStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBodyStyle}">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
</ResourceDictionary>
