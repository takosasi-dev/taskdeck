<UserControl x:Class="TaskDeck.App.Controls.LinkPreviewList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <!--
        メモの URL とそのタイトル（F-196、既定 OFF）。設定が OFF・オフライン・URL が無いときは何も出さない。
        タイトルが取れていなければ URL をそのまま出す。押すと既定のブラウザで開く（http/https だけ）。件数は5件まで。
    -->
    <ItemsControl x:Name="LinkItems" AutomationProperties.Name="メモのリンク" Focusable="False">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Style="{StaticResource ListRowButtonStyle}"
                        Height="Auto"
                        MinHeight="34"
                        Padding="8,4"
                        Margin="0,0,0,2"
                        Click="OnOpenLink"
                        ToolTip="{Binding Url}"
                        AutomationProperties.Name="{Binding AutomationName}">
                    <DockPanel>
                        <Viewbox DockPanel.Dock="Left" Width="14" Height="14" Margin="0,2,8,0" VerticalAlignment="Top">
                            <Path Style="{StaticResource IconPathStyle}"
                                  Stroke="{DynamicResource TextTertiaryBrush}"
                                  Data="{StaticResource IconArrowRight}" />
                        </Viewbox>
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextBodySmallStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding DisplayTitle}" />
                            <TextBlock Style="{StaticResource TextCaptionStyle}"
                                       FontSize="{StaticResource TypeLabelSize}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Host}" />
                        </StackPanel>
                    </DockPanel>
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
