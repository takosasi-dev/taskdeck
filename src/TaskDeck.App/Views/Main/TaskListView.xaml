<UserControl x:Class="TaskDeck.App.Views.Main.TaskListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:TaskDeck.App.Behaviors"
             xmlns:controls="clr-namespace:TaskDeck.App.Controls"
             xmlns:conv="clr-namespace:TaskDeck.App.Converters"
             xmlns:input="clr-namespace:TaskDeck.App.Input"
             xmlns:main="clr-namespace:TaskDeck.App.Views.Main"
             xmlns:pickers="clr-namespace:TaskDeck.App.Controls.Pickers"
             xmlns:vm="clr-namespace:TaskDeck.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TaskListViewModel}">
    <UserControl.Resources>
        <conv:IconKeyToGeometryConverter x:Key="IconGeometry" />
        <conv:HexToBrushConverter x:Key="HexBrush" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />

        <!-- 複数選択中だけ出すもの（一括ツールバーと、その下に隠れないための一覧の余白）。ゴミ箱では出さない -->
        <Style x:Key="BulkOnlyStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMultiSelection}" Value="True" />
                        <Condition Binding="{Binding IsTrashView}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 一括ツールバーのボタン（暗い地の上。32 の丸、ホバーは地を敷かず濃さで示す） -->
        <Style x:Key="BulkButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ToastForegroundBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource TypeCaptionSize}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualRowStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PopupShadowBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BulkIconStyle" TargetType="Path" BasedOn="{StaticResource IconPathStyle}">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <main:ListRowStyleSelector x:Key="RowStyleSelector"
                                   RowStyle="{StaticResource TaskRowContainerStyle}"
                                   PlainStyle="{StaticResource PlainRowContainerStyle}" />

        <!-- グループ見出し（行として平らに並べる）。期限切れは警告アイコン＋赤 -->
        <DataTemplate DataType="{x:Type vm:TaskGroupHeaderViewModel}">
            <DockPanel Margin="8,14,8,6">
                <Viewbox DockPanel.Dock="Left" Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center"
                         Visibility="{Binding IsWarning, Converter={StaticResource BoolVisibility}}">
                    <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconWarning}" Stroke="{DynamicResource StateOverdueBrush}" />
                </Viewbox>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource GroupHeaderTitleStyle}" Text="{Binding Title}" />
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource GroupHeaderCountStyle}" Text="{Binding Count}" />
                <Border Style="{StaticResource GroupHeaderLineStyle}" />
            </DockPanel>
        </DataTemplate>

        <!--
            テンプレートから一度に作った一群の見出し（F-15B）。「週次レビュー（9/23 に作成） 5」＋まとめて完了・まとめて削除（取り消しは1段）。
            日付の見出しより一段軽く見せる（テンプレートのアイコン、線なし）
        -->
        <DataTemplate DataType="{x:Type vm:TemplateBatchHeaderViewModel}">
            <DockPanel Margin="8,8,8,2" Height="28">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource LeftTextButtonStyle}"
                            MinHeight="24" Height="24" Padding="8,0"
                            FontSize="{StaticResource TypeCaptionSize}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Content="まとめて完了"
                            AutomationProperties.Name="{Binding CompleteName}"
                            ToolTip="この一群の未完了をまとめて完了にします（元に戻せます）"
                            Click="OnBatchCompleteClick" />
                    <Button Style="{StaticResource LeftTextButtonStyle}"
                            MinHeight="24" Height="24" Padding="8,0" Margin="2,0,0,0"
                            FontSize="{StaticResource TypeCaptionSize}"
                            Foreground="{DynamicResource DangerBrush}"
                            Content="まとめて削除"
                            AutomationProperties.Name="{Binding DeleteName}"
                            ToolTip="この一群をまとめてゴミ箱へ移します（元に戻せます）"
                            Click="OnBatchDeleteClick" />
                </StackPanel>
                <Viewbox DockPanel.Dock="Left" Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconTemplate}" Stroke="{DynamicResource TextSecondaryBrush}" />
                </Viewbox>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource GroupHeaderTitleStyle}" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource GroupHeaderCountStyle}" HorizontalAlignment="Left" Text="{Binding Count}" />
            </DockPanel>
        </DataTemplate>

        <!--
            末尾の入力行（Ctrl+N）。普段は「＋ タスクを追加 Ctrl+N」と見える入力欄で、押すとそのまま打てる。
            IME の変換確定 Enter では登録しない。フォーカスは TaskListView が明示的に入れる（読み直しで横取りしない）。
        -->
        <DataTemplate DataType="{x:Type vm:AddTaskRowViewModel}">
            <DockPanel Height="42" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinHeight="0" Height="28" Padding="12,0" Margin="8,0,8,0"
                        VerticalAlignment="Center"
                        Content="追加"
                        AutomationProperties.Name="入力したタスクを追加"
                        Click="OnAddSubmitClick"
                        Visibility="{Binding HasText, Converter={StaticResource BoolVisibility}}" />
                <Grid VerticalAlignment="Center">
                    <TextBox x:Name="AddEditor"
                             Style="{StaticResource AddRowTextBoxStyle}"
                             input:ImeGuard.IsEnabled="True"
                             AutomationProperties.Name="新しいタスク"
                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="OnAddRowKeyDown" />
                    <Path Style="{StaticResource IconPathStyle}"
                          Data="{StaticResource IconAdd}"
                          Stroke="{DynamicResource TextTertiaryBrush}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Margin="9,0,0,0"
                          IsHitTestVisible="False" />
                    <TextBlock Margin="34,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBodySmallStyle}">
                                <Setter Property="Text" Value="{Binding Hint}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=AddEditor}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <!-- 打てる状態になったら、書き方の例を出す -->
                                    <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=AddEditor}" Value="True">
                                        <Setter Property="Text" Value="{Binding ExampleHint}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </DataTemplate>

        <!-- 名前をその場で変える欄（F2／Enter）。編集中の行だけに作る -->
        <DataTemplate x:Key="RenameEditorTemplate">
            <TextBox Style="{StaticResource InlineTextBoxStyle}"
                     VerticalAlignment="Center"
                     input:ImeGuard.IsEnabled="True"
                     behaviors:AutoFocus.WhenVisible="True"
                     AutomationProperties.Name="タスクの名前"
                     Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="OnRenameKeyDown"
                     LostKeyboardFocus="OnRenameLostFocus" />
        </DataTemplate>

        <!-- ゴミ箱の行の操作。ゴミ箱の行だけに作る -->
        <DataTemplate x:Key="TrashActionsTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource LeftTextButtonStyle}" Content="元に戻す" Margin="8,0,0,0" MinHeight="26" Padding="8,0"
                        AutomationProperties.Name="ゴミ箱から元に戻す"
                        Click="OnRestoreClick" />
                <Button Style="{StaticResource LeftTextButtonStyle}" Content="完全に削除" Margin="4,0,0,0" MinHeight="26" Padding="8,0"
                        Foreground="{DynamicResource DangerBrush}"
                        AutomationProperties.Name="完全に削除"
                        Click="OnPurgeClick" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="RenameHostStyle" TargetType="ContentControl" BasedOn="{StaticResource LazyPartStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Content" Value="{Binding}" />
                    <Setter Property="ContentTemplate" Value="{StaticResource RenameEditorTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TrashHostStyle" TargetType="ContentControl" BasedOn="{StaticResource LazyPartStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInTrash}" Value="True">
                    <Setter Property="Content" Value="{Binding}" />
                    <Setter Property="ContentTemplate" Value="{StaticResource TrashActionsTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- タスク行（UI 設計書 6.1）: [8][☑17][10][優先度22][10][タイトル][10][タグ][プロジェクト][期限58][8] -->
        <DataTemplate DataType="{x:Type vm:TaskRowViewModel}">
            <Grid Height="{Binding RowHeight}" Background="Transparent">
                <DockPanel Margin="8,0" VerticalAlignment="Center">
                    <Border DockPanel.Dock="Left" Width="{Binding Indent}" />
                    <Grid DockPanel.Dock="Left" Width="17" Margin="0,0,10,0" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource RowCheckBoxStyle}"
                                  IsChecked="{Binding IsClosed, Mode=OneWay}"
                                  IsEnabled="{Binding CanCheck}"
                                  AutomationProperties.Name="{Binding AutomationName}"
                                  Checked="OnRowChecked"
                                  Unchecked="OnRowChecked" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Left"
                               Style="{StaticResource RowPriorityStyle}"
                               Margin="0,0,10,0"
                               Text="{Binding PrioritySymbol}"
                               Visibility="{Binding IsSubtask, Converter={StaticResource InverseBoolVisibility}}" />

                    <!-- 右側（先に書いたものほど右端に寄る）: 期限・出どころ・ゴミ箱の操作・プロジェクト・タグ・繰り返し・進捗 -->
                    <TextBlock DockPanel.Dock="Right"
                               Style="{StaticResource RowDueStyle}"
                               Margin="10,0,0,0"
                               Text="{Binding DueText}" />
                    <TextBlock DockPanel.Dock="Right"
                               Style="{StaticResource RowSourceTextStyle}"
                               Text="{Binding SearchSource}"
                               Visibility="{Binding HasSearchSource, Converter={StaticResource BoolVisibility}}" />
                    <ContentControl DockPanel.Dock="Right" Style="{StaticResource TrashHostStyle}" />
                    <Border DockPanel.Dock="Right"
                            Style="{StaticResource RowChipBorderStyle}"
                            Margin="8,0,0,0"
                            Visibility="{Binding HasProject, Converter={StaticResource BoolVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource RowProjectDotStyle}"
                                     Fill="{Binding ProjectColorHex, Converter={StaticResource HexBrush}}" />
                            <TextBlock Style="{StaticResource RowChipTextStyle}" Text="{Binding ProjectName}" />
                        </StackPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Right"
                               Style="{StaticResource RowTagTextStyle}"
                               Margin="8,0,0,0"
                               Text="{Binding TagsText}"
                               Visibility="{Binding HasTags, Converter={StaticResource BoolVisibility}}" />
                    <Viewbox DockPanel.Dock="Right" Width="13" Height="13" Margin="8,0,0,0" VerticalAlignment="Center"
                             ToolTip="繰り返し"
                             Visibility="{Binding HasRecurrence, Converter={StaticResource BoolVisibility}}">
                        <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconRepeat}" Stroke="{DynamicResource TextSecondaryBrush}" />
                    </Viewbox>
                    <!-- 親の進捗（完了数/全数とバー F-023）。バーは割合で横に縮める（幅の計算を ViewModel に持たせない） -->
                    <Border DockPanel.Dock="Right"
                            Width="22" Height="3" Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            CornerRadius="1.5"
                            Background="{DynamicResource StrokeSubtleBrush}"
                            Visibility="{Binding HasSubtasks, Converter={StaticResource BoolVisibility}}">
                        <Border Background="{DynamicResource AccentDefaultBrush}" CornerRadius="1.5" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding SubtaskRatio}" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <TextBlock DockPanel.Dock="Right"
                               Style="{StaticResource RowChipTextStyle}"
                               Margin="8,0,0,0"
                               Typography.NumeralAlignment="Tabular"
                               ToolTip="サブタスクの完了数"
                               Text="{Binding SubtaskProgress}"
                               Visibility="{Binding HasSubtasks, Converter={StaticResource BoolVisibility}}" />

                    <!-- タイトル（1行で省略。検索中は一致部分に地色。メモだけが一致したときは「メモ：」＋抜粋） -->
                    <Grid>
                        <DockPanel Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolVisibility}}">
                            <TextBlock DockPanel.Dock="Left"
                                       Style="{StaticResource RowChipTextStyle}"
                                       Margin="0,0,2,0"
                                       Text="メモ："
                                       Visibility="{Binding HasNoteSnippet, Converter={StaticResource BoolVisibility}}" />
                            <TextBlock Style="{StaticResource RowTitleStyle}"
                                       ToolTip="{Binding Title}"
                                       behaviors:HighlightText.Text="{Binding DisplayTitle}"
                                       behaviors:HighlightText.Terms="{Binding SearchTerms}" />
                        </DockPanel>
                        <ContentControl Style="{StaticResource RenameHostStyle}" />
                    </Grid>
                </DockPanel>
            </Grid>
        </DataTemplate>

        <!-- 並び替え・期間などの選択肢（左に選択中の印） -->
        <DataTemplate x:Key="SortChoiceTemplate">
            <Button Style="{StaticResource MenuChoiceButtonStyle}"
                    Command="{Binding DataContext.SetSortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Click="OnSortChoiceClick">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource MenuCheckMarkStyle}" />
                    <TextBlock Style="{StaticResource TextBodySmallStyle}" VerticalAlignment="Center" Text="{Binding Label}" />
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="SortDirectionTemplate">
            <Button Style="{StaticResource MenuChoiceButtonStyle}"
                    Command="{Binding DataContext.SetSortDirectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Click="OnSortChoiceClick">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource MenuCheckMarkStyle}" />
                    <TextBlock Style="{StaticResource TextBodySmallStyle}" VerticalAlignment="Center" Text="{Binding Label}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 見出し: ビュー名（22px）＋補足、右に操作 -->
        <DockPanel Grid.Row="0" Margin="20,20,20,12" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                <Button Style="{StaticResource ListToolbarButtonStyle}"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="フォーカスモードを開く"
                        ToolTip="フォーカスモード（Ctrl+Shift+F）"
                        Click="OnFocusModeClick"
                        Visibility="{Binding IsTodayView, Converter={StaticResource BoolVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                            <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconFocus}" />
                        </Viewbox>
                        <TextBlock Style="{StaticResource TextBodySmallStyle}" Margin="6,0,0,0" VerticalAlignment="Center" Text="フォーカス" />
                    </StackPanel>
                </Button>

                <ItemsControl ItemsSource="{Binding PeriodOptions}"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="期間"
                              Visibility="{Binding IsCompletedView, Converter={StaticResource BoolVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PeriodButtonStyle}"
                                    Margin="2,0,0,0"
                                    Content="{Binding Label}"
                                    AutomationProperties.Name="{Binding Label, StringFormat='期間 {0}'}"
                                    Command="{Binding DataContext.SetPeriodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Style="{StaticResource ListToolbarButtonStyle}"
                        Margin="0,0,8,0"
                        Content="ゴミ箱を空にする"
                        AutomationProperties.Name="ゴミ箱を空にする"
                        IsEnabled="{Binding CanPurgeAll}"
                        Click="OnPurgeAllClick"
                        Visibility="{Binding IsTrashView, Converter={StaticResource BoolVisibility}}" />

                <Button x:Name="SortButton"
                        Style="{StaticResource ListToolbarButtonStyle}"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="並び替え"
                        ToolTip="並び替え"
                        Click="OnSortClick">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                            <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconSort}" />
                        </Viewbox>
                        <TextBlock Style="{StaticResource TextBodySmallStyle}" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding CurrentSortLabel}" />
                    </StackPanel>
                </Button>

                <!-- 絞り込み（中身は波2-G の FilterPanel）。効いている間は「絞り込み中」と解除ボタン -->
                <Button x:Name="FilterButton"
                        AutomationProperties.Name="絞り込み"
                        Click="OnFilterClick">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ListToolbarButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                            <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconFilter}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Viewbox>
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBodySmallStyle}">
                                    <Setter Property="Text" Value="絞り込み" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                                            <Setter Property="Text" Value="絞り込み中" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}"
                        Width="30" Height="30" Margin="2,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="絞り込みを解除"
                        ToolTip="絞り込みを解除"
                        Command="{Binding ClearFilterCommand}"
                        Visibility="{Binding IsFiltered, Converter={StaticResource BoolVisibility}}">
                    <Viewbox Width="12" Height="12">
                        <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconClose}" Stroke="{DynamicResource TextSecondaryBrush}" />
                    </Viewbox>
                </Button>
            </StackPanel>

            <StackPanel VerticalAlignment="Bottom">
                <TextBlock Style="{StaticResource TextTitleStyle}" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource TextCaptionStyle}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text="{Binding Subtitle}" />
            </StackPanel>
        </DockPanel>

        <Popup x:Name="SortPopup"
               Grid.Row="0"
               PlacementTarget="{Binding ElementName=SortButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="None"
               PreviewKeyDown="OnPopupKeyDown">
            <Border Style="{StaticResource PopupShadowStyle}">
                <Border Style="{StaticResource PopupSurfaceStyle}" Width="{StaticResource SmallPopupWidth}" Padding="4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextLabelStyle}" Margin="8,4,0,4" Text="並び替え" />
                        <ItemsControl ItemsSource="{Binding SortOptions}" ItemTemplate="{StaticResource SortChoiceTemplate}" />
                        <Border Height="1" Margin="4,4" Background="{DynamicResource StrokeSubtleBrush}" />
                        <ItemsControl ItemsSource="{Binding SortDirections}" ItemTemplate="{StaticResource SortDirectionTemplate}" />
                    </StackPanel>
                </Border>
            </Border>
        </Popup>

        <!-- 絞り込みパネル（波2-G）は自分で影と面の枠と幅を持つ。ここは Popup の直下に置くだけ（影の余白ぶんずらす） -->
        <Popup x:Name="FilterPopup"
               Grid.Row="0"
               PlacementTarget="{Binding ElementName=FilterButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="None"
               HorizontalOffset="-10"
               VerticalOffset="-8">
            <controls:FilterPanel x:Name="FilterPanelHost" />
        </Popup>

        <!-- 本体（仮想化する。ScrollViewer で包まない） -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                右 4px＋行の右 8px がスクロールバーの通り道（WPF-UI のスクロールバーは中身の上に重なるため）。
                複数選択（Ctrl+クリック・Shift+クリック・Ctrl+A、S-10）は Extended。選びは View と ViewModel で写し合う（TaskListView.xaml.cs）。
                ListBox の派生なので、WPF-UI の ListBox のスタイルを明示して当てる
            -->
            <main:TaskListBox x:Name="RowList"
                              Style="{StaticResource {x:Type ListBox}}"
                              Margin="12,0,4,0"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0"
                              AutomationProperties.Name="タスクの一覧"
                              ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              SelectionMode="Extended"
                              ItemContainerStyle="{x:Null}"
                              ItemContainerStyleSelector="{StaticResource RowStyleSelector}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              VirtualizingPanel.CacheLengthUnit="Item"
                              VirtualizingPanel.CacheLength="2"
                              SelectionChanged="OnSelectionChanged"
                              PreviewMouseLeftButtonDown="OnListMouseDown"
                              PreviewMouseMove="OnListMouseMove"
                              PreviewMouseLeftButtonUp="OnListMouseUp"
                              PreviewKeyDown="OnListKeyDown"
                              ContextMenuOpening="OnRowContextMenuOpening"
                              AllowDrop="True"
                              DragOver="OnListDragOver"
                              DragLeave="OnListDragLeave"
                              Drop="OnListDrop">
                <!--
                    行の右クリックメニュー（Shift+F10・アプリケーションキーでも開く。詳細ペインの「…」からも開く）。
                    どの行かは開くときにコードで決める（見出し・入力行・ゴミ箱の行では出さない）。DataContext は一覧の ViewModel。
                    複数選択中は、完了・期限・優先度・プロジェクト・削除が選んだ行ぜんぶに効く
                -->
                <main:TaskListBox.ContextMenu>
                    <ContextMenu x:Name="RowMenu" AutomationProperties.Name="タスクの操作">
                        <MenuItem x:Name="RowMenuComplete" Header="完了にする" InputGestureText="Space"
                                  AutomationProperties.AutomationId="RowMenuComplete" Click="OnRowMenuComplete" />
                        <MenuItem x:Name="RowMenuRename" Header="名前を変更" InputGestureText="F2"
                                  AutomationProperties.AutomationId="RowMenuRename" Click="OnRowMenuRename" />
                        <MenuItem Header="期限" AutomationProperties.AutomationId="RowMenuDue">
                            <MenuItem x:Name="RowMenuDueToday" Header="今日" Tag="today" AutomationProperties.AutomationId="RowMenuDueToday" Click="OnRowMenuDue" />
                            <MenuItem x:Name="RowMenuDueTomorrow" Header="明日" Tag="tomorrow" AutomationProperties.AutomationId="RowMenuDueTomorrow" Click="OnRowMenuDue" />
                            <MenuItem x:Name="RowMenuDueNextWeek" Header="来週" Tag="nextweek" AutomationProperties.AutomationId="RowMenuDueNextWeek" Click="OnRowMenuDue" />
                            <MenuItem Header="期限なし" Tag="none" AutomationProperties.AutomationId="RowMenuDueNone" Click="OnRowMenuDue" />
                            <Separator />
                            <MenuItem Header="日付を選ぶ…" AutomationProperties.AutomationId="RowMenuDuePick" Click="OnRowMenuPickDue" />
                        </MenuItem>
                        <MenuItem Header="優先度" AutomationProperties.AutomationId="RowMenuPriority">
                            <MenuItem Header="緊急" Tag="Urgent" Click="OnRowMenuPriority" />
                            <MenuItem Header="高" Tag="High" Click="OnRowMenuPriority" />
                            <MenuItem Header="中" Tag="Medium" Click="OnRowMenuPriority" />
                            <MenuItem Header="低" Tag="Low" Click="OnRowMenuPriority" />
                            <MenuItem Header="なし" Tag="None" Click="OnRowMenuPriority" />
                        </MenuItem>
                        <MenuItem Header="プロジェクトへ移動"
                                  AutomationProperties.AutomationId="RowMenuProject"
                                  ItemsSource="{Binding ProjectChoices}"
                                  Click="OnRowMenuProject">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <MenuItem x:Name="RowMenuDuplicate" Header="複製" InputGestureText="Ctrl+D"
                                  AutomationProperties.AutomationId="RowMenuDuplicate" Click="OnRowMenuDuplicate" />
                        <MenuItem x:Name="RowMenuAddSubtask" Header="サブタスクを追加"
                                  AutomationProperties.AutomationId="RowMenuAddSubtask" Click="OnRowMenuAddSubtask" />
                        <MenuItem Header="テンプレートにする"
                                  AutomationProperties.AutomationId="RowMenuTemplate" Click="OnRowMenuTemplate" />
                        <Separator />
                        <MenuItem Header="削除" InputGestureText="Delete"
                                  AutomationProperties.AutomationId="RowMenuDelete" Click="OnRowMenuDelete" />
                    </ContextMenu>
                </main:TaskListBox.ContextMenu>
            </main:TaskListBox>

            <!-- 一括ツールバーに最下行が隠れないよう、出ている間は一覧の下を 56px 空ける（UI 設計書 15.1） -->
            <Border Grid.Row="1" Height="56" Style="{StaticResource BulkOnlyStyle}" />

            <!-- ドラッグ中の挿入位置（UI 設計書 15.5: 2px のアクセント線＋左端に丸点）。行の前後に落とすときだけ出す -->
            <Canvas x:Name="DropLayer" Grid.Row="0" IsHitTestVisible="False">
                <Grid x:Name="DropLine" Height="8" Visibility="Collapsed">
                    <Border Height="2" Margin="4,0,0,0" CornerRadius="1" VerticalAlignment="Center" Background="{DynamicResource AccentDefaultBrush}" />
                    <Ellipse Width="8" Height="8" HorizontalAlignment="Left" Fill="{DynamicResource AccentDefaultBrush}" />
                </Grid>
            </Canvas>

            <!-- 読み込みが 200ms を超えたときだけ出すスケルトン（スピナーは使わない） -->
            <StackPanel VerticalAlignment="Top" Margin="20,8,20,0" IsHitTestVisible="False"
                        Visibility="{Binding IsSkeletonVisible, Converter={StaticResource BoolVisibility}}">
                <DockPanel Height="42">
                    <Border DockPanel.Dock="Left" Style="{StaticResource SkeletonBlockStyle}" Width="15" Height="15" Margin="0,0,10,0" />
                    <Border DockPanel.Dock="Right" Style="{StaticResource SkeletonBlockStyle}" Width="40" Margin="10,0,0,0" />
                    <Border Style="{StaticResource SkeletonBlockStyle}" HorizontalAlignment="Left" Width="240" />
                </DockPanel>
                <DockPanel Height="42">
                    <Border DockPanel.Dock="Left" Style="{StaticResource SkeletonBlockStyle}" Width="15" Height="15" Margin="0,0,10,0" />
                    <Border DockPanel.Dock="Right" Style="{StaticResource SkeletonBlockStyle}" Width="40" Margin="10,0,0,0" />
                    <Border Style="{StaticResource SkeletonBlockStyle}" HorizontalAlignment="Left" Width="320" />
                </DockPanel>
                <DockPanel Height="42" Opacity="0.8">
                    <Border DockPanel.Dock="Left" Style="{StaticResource SkeletonBlockStyle}" Width="15" Height="15" Margin="0,0,10,0" />
                    <Border DockPanel.Dock="Right" Style="{StaticResource SkeletonBlockStyle}" Width="40" Margin="10,0,0,0" />
                    <Border Style="{StaticResource SkeletonBlockStyle}" HorizontalAlignment="Left" Width="180" />
                </DockPanel>
                <DockPanel Height="42" Opacity="0.6">
                    <Border DockPanel.Dock="Left" Style="{StaticResource SkeletonBlockStyle}" Width="15" Height="15" Margin="0,0,10,0" />
                    <Border DockPanel.Dock="Right" Style="{StaticResource SkeletonBlockStyle}" Width="40" Margin="10,0,0,0" />
                    <Border Style="{StaticResource SkeletonBlockStyle}" HorizontalAlignment="Left" Width="280" />
                </DockPanel>
            </StackPanel>

            <!-- 空状態（UI 設計書 15.4）。イラストは置かず、アイコン1つと文言と次の操作だけ -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="360" Padding="24,20" CornerRadius="6" BorderThickness="1"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <!-- 初回起動だけは案内であることを示す（地を Surface.Selected に） -->
                            <DataTrigger Binding="{Binding IsFirstRunEmpty}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource SurfaceSelectedStrokeBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <Viewbox Width="34" Height="34" HorizontalAlignment="Center">
                        <Path Data="{Binding EmptyIconKey, Converter={StaticResource IconGeometry}}">
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource IconPathStyle}">
                                    <Setter Property="Stroke" Value="{DynamicResource TextDisabledBrush}" />
                                    <Setter Property="StrokeThickness" Value="1.2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFirstRunEmpty}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource AccentDefaultBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Viewbox>
                    <TextBlock Style="{StaticResource TextBodySmallStyle}"
                               Margin="0,12,0,0"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{Binding EmptyTitle}" />
                    <TextBlock Style="{StaticResource TextCaptionStyle}"
                               Margin="0,8,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{Binding EmptyMessage}" />
                    <Button Margin="0,14,0,0"
                            HorizontalAlignment="Center"
                            MinHeight="0" Height="28" Padding="14,0"
                            Content="{Binding EmptyActionLabel}"
                            Command="{Binding InvokeEmptyActionCommand}"
                            Visibility="{Binding HasEmptyAction, Converter={StaticResource BoolVisibility}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
                                <Style.Triggers>
                                    <!-- 「すべてのタスクから探す」は主ボタン（モックアップどおり） -->
                                    <DataTrigger Binding="{Binding EmptyIconKey}" Value="IconSearch">
                                        <Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!--
                複数選択のツールバー（S-10、UI 設計書 15.1）。一覧の下端中央から浮かぶ（下から 12px、高さ 42 の全丸、地は暗色）。
                件数 → 完了・期限・優先度・プロジェクト・タグ → 区切り → 削除（赤系）・選択解除。影は DropShadowEffect を使わず面を重ねる
            -->
            <Grid Grid.Row="0" Grid.RowSpan="2"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  Margin="0,0,0,12"
                  Style="{StaticResource BulkOnlyStyle}">
                <Border CornerRadius="23" Margin="-2,-1,-2,-4" Background="{DynamicResource PopupShadowBrush}" />
                <Border x:Name="BulkToolbar"
                        Height="42"
                        CornerRadius="21"
                        Padding="14,0,6,0"
                        Background="{DynamicResource ToastBackgroundBrush}"
                        AutomationProperties.Name="選択したタスクの操作">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TextCaptionStyle}"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ToastForegroundBrush}"
                                   Typography.NumeralAlignment="Tabular"
                                   Text="{Binding SelectionSummary}" />
                        <Button Style="{StaticResource BulkButtonStyle}"
                                AutomationProperties.Name="選択したタスクを完了にする"
                                ToolTip="完了にする（Space）"
                                Command="{Binding CompleteSelectedCommand}">
                            <Viewbox Width="15" Height="15">
                                <Path Style="{StaticResource BulkIconStyle}" Data="{StaticResource IconCheck}" StrokeThickness="1.8" />
                            </Viewbox>
                        </Button>
                        <Button x:Name="BulkDueButton"
                                Style="{StaticResource BulkButtonStyle}"
                                AutomationProperties.Name="期限を変更する"
                                ToolTip="期限を変える"
                                Click="OnBulkDueClick">
                            <Viewbox Width="15" Height="15">
                                <Path Style="{StaticResource BulkIconStyle}" Data="{StaticResource IconCalendar}" />
                            </Viewbox>
                        </Button>
                        <Button x:Name="BulkPriorityButton"
                                Style="{StaticResource BulkButtonStyle}"
                                AutomationProperties.Name="優先度を変更する"
                                ToolTip="優先度を変える"
                                Content="!"
                                Click="OnBulkPriorityClick" />
                        <Button x:Name="BulkProjectButton"
                                Style="{StaticResource BulkButtonStyle}"
                                AutomationProperties.Name="プロジェクトを変更する"
                                ToolTip="プロジェクトへ移す"
                                Click="OnBulkProjectClick">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource ToastForegroundBrush}" />
                        </Button>
                        <Button x:Name="BulkTagButton"
                                Style="{StaticResource BulkButtonStyle}"
                                AutomationProperties.Name="タグを付ける"
                                ToolTip="タグを付ける"
                                Content="#"
                                Click="OnBulkTagClick" />
                        <Border Width="1" Height="20" Margin="3,0" Background="{DynamicResource ToastForegroundBrush}" Opacity="0.3" />
                        <Button Style="{StaticResource BulkButtonStyle}"
                                Foreground="{DynamicResource BulkDangerBrush}"
                                AutomationProperties.Name="選択したタスクを削除する"
                                ToolTip="削除（Delete）"
                                Command="{Binding DeleteSelectedCommand}">
                            <Viewbox Width="15" Height="15">
                                <Path Style="{StaticResource BulkIconStyle}" Data="{StaticResource IconTrash}" />
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource BulkButtonStyle}"
                                Opacity="0.8"
                                AutomationProperties.Name="選択を解除する"
                                ToolTip="選択を解除（Esc）"
                                Command="{Binding ClearSelectionCommand}">
                            <Viewbox Width="10" Height="10">
                                <Path Style="{StaticResource BulkIconStyle}" Data="{StaticResource IconClose}" />
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!--
                値を選ぶポップアップ（一括ツールバー・行の右クリックメニューで共用）。パネルが影と面の枠を持つ（INTERFACES 5.3）。
                開くときに PlacementTarget と Placement をコードで決める（ツールバーからは上、行からは下）
            -->
            <Popup x:Name="DuePopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
                <pickers:DatePickerPanel x:Name="DuePicker" />
            </Popup>
            <Popup x:Name="PriorityPopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
                <pickers:PriorityPickerPanel x:Name="PriorityPicker" />
            </Popup>
            <Popup x:Name="ProjectPopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
                <pickers:ProjectPickerPanel x:Name="ProjectPicker" />
            </Popup>

            <!-- タグを付ける（既存のタグを押す／名前を打って Enter で、無ければ作って付ける F-044） -->
            <Popup x:Name="TagPopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None" PreviewKeyDown="OnPopupKeyDown">
                <Border Style="{StaticResource PopupShadowStyle}">
                    <Border Style="{StaticResource PopupSurfaceStyle}" Width="{StaticResource SmallPopupWidth}" Padding="6">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextLabelStyle}" Margin="4,2,0,6" Text="タグを付ける" />
                            <TextBox x:Name="TagNameBox"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     MinHeight="0"
                                     Height="30"
                                     input:ImeGuard.IsEnabled="True"
                                     AutomationProperties.Name="付けるタグの名前"
                                     PreviewKeyDown="OnTagNameKeyDown" />
                            <ItemsControl Margin="0,6,0,0" MaxHeight="220" Focusable="False" ItemsSource="{Binding TagChoices}">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MenuChoiceButtonStyle}"
                                                Content="{Binding Label}"
                                                AutomationProperties.Name="{Binding Label}"
                                                Click="OnTagChoiceClick" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</UserControl>
