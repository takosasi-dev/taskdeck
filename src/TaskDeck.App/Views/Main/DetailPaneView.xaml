<UserControl x:Class="TaskDeck.App.Views.Main.DetailPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TaskDeck.App.Controls"
             xmlns:conv="clr-namespace:TaskDeck.App.Converters"
             xmlns:input="clr-namespace:TaskDeck.App.Input"
             xmlns:pickers="clr-namespace:TaskDeck.App.Controls.Pickers"
             xmlns:vm="clr-namespace:TaskDeck.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TaskDetailViewModel}"
             PreviewKeyDown="OnPaneKeyDown">
    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexBrush" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />

        <!-- 値の行（アイコン＋ラベル＋値）。押すとその項目のポップアップが出る -->
        <Style x:Key="DetailRowButtonStyle" TargetType="Button" BasedOn="{StaticResource LeftTextButtonStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="-4,0,-4,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="DetailLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBodySmallStyle}">
            <Setter Property="Width" Value="68" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,10,0" />
        </Style>

        <!-- 値。「なし」は薄く（モックアップの「繰り返し なし」） -->
        <Style x:Key="DetailValueStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBodySmallStyle}">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <Trigger Property="Text" Value="なし">
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailPriorityValueStyle" TargetType="TextBlock" BasedOn="{StaticResource DetailValueStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Priority}" Value="Urgent">
                    <Setter Property="Foreground" Value="{DynamicResource PriorityUrgentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="High">
                    <Setter Property="Foreground" Value="{DynamicResource PriorityHighBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="Medium">
                    <Setter Property="Foreground" Value="{DynamicResource PriorityMediumBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="Low">
                    <Setter Property="Foreground" Value="{DynamicResource PriorityLowBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 行のアイコン（16px の線画を 15px に縮める） -->
        <Style x:Key="DetailIconBoxStyle" TargetType="Viewbox">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DetailIconStyle" TargetType="Path" BasedOn="{StaticResource IconPathStyle}">
            <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
        </Style>

        <!-- 選択肢のポップアップ（状態・通知・所要時間）。どの一覧から来たかで動きが違うので分けてある -->
        <DataTemplate x:Key="StatusChoiceTemplate">
            <Button Style="{StaticResource MenuChoiceButtonStyle}" Content="{Binding Label}" Click="OnStatusChoiceClick" />
        </DataTemplate>
        <DataTemplate x:Key="ReminderChoiceTemplate">
            <Button Style="{StaticResource MenuChoiceButtonStyle}" Content="{Binding Label}" Click="OnReminderChoiceClick" />
        </DataTemplate>
        <DataTemplate x:Key="DurationChoiceTemplate">
            <Button Style="{StaticResource MenuChoiceButtonStyle}" Content="{Binding Label}" Click="OnDurationChoiceClick" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Visibility="{Binding HasTask, Converter={StaticResource BoolVisibility}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 項目は数が決まっている（サブタスクも1件の子だけ）ので、ここは ScrollViewer で包んでよい -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="18,20,18,8">
                <!-- タイトル（フォーカスアウト／IME 安全な Enter で確定。5行まで） -->
                <TextBox x:Name="TitleBox"
                         Style="{StaticResource InlineTextBoxStyle}"
                         FontSize="{StaticResource TypeSubtitleSize}"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         MaxLines="5"
                         VerticalScrollBarVisibility="Disabled"
                         input:ImeGuard.IsEnabled="True"
                         AutomationProperties.Name="タスクのタイトル"
                         ToolTip="{Binding Title}"
                         Text="{Binding Title, Mode=OneWay}"
                         PreviewKeyDown="OnTitleKeyDown"
                         LostKeyboardFocus="OnTitleLostFocus" />

                <!-- メモ（フォーカスアウトで確定） -->
                <Border Margin="0,14,0,0"
                        Background="{DynamicResource SurfaceSubtleBrush}"
                        BorderBrush="{DynamicResource StrokeSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusRow}"
                        Padding="10,8"
                        MinHeight="52">
                    <Grid>
                        <TextBlock Foreground="{DynamicResource TextTertiaryBrush}"
                                   IsHitTestVisible="False"
                                   Text="メモを追加">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBodySmallStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=NotesBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="NotesBox"
                                 Style="{StaticResource InlineTextBoxStyle}"
                                 FontSize="{StaticResource TypeBodySmallSize}"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalAlignment="Top"
                                 MaxHeight="160"
                                 VerticalScrollBarVisibility="Auto"
                                 input:ImeGuard.IsEnabled="True"
                                 AutomationProperties.Name="メモ"
                                 Text="{Binding Notes, Mode=OneWay}"
                                 LostKeyboardFocus="OnNotesLostFocus" />
                    </Grid>
                </Border>

                <!-- メモ内のリンク（中身は波3-K） -->
                <controls:LinkPreviewList Margin="0,6,0,0" Text="{Binding Notes}" />

                <StackPanel Margin="0,12,0,0">
                    <!-- 状態 -->
                    <Button x:Name="StatusRow" Style="{StaticResource DetailRowButtonStyle}" Click="OnStatusClick"
                            AutomationProperties.Name="状態を変える">
                        <DockPanel>
                            <Viewbox DockPanel.Dock="Left" Style="{StaticResource DetailIconBoxStyle}">
                                <Path Style="{StaticResource DetailIconStyle}" Data="{StaticResource IconCheckCircle}" />
                            </Viewbox>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource DetailLabelStyle}" Text="状態" />
                            <TextBlock Style="{StaticResource DetailValueStyle}" Text="{Binding StatusText}" />
                        </DockPanel>
                    </Button>

                    <!-- 期限 -->
                    <Button x:Name="DueRow" Style="{StaticResource DetailRowButtonStyle}" Click="OnDueClick"
                            AutomationProperties.Name="期限を変える">
                        <DockPanel>
                            <Viewbox DockPanel.Dock="Left" Style="{StaticResource DetailIconBoxStyle}">
                                <Path Style="{StaticResource DetailIconStyle}" Data="{StaticResource IconCalendar}" />
                            </Viewbox>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource DetailLabelStyle}" Text="期限" />
                            <TextBlock Style="{StaticResource DetailValueStyle}" Typography.NumeralAlignment="Tabular" Text="{Binding DueText}" />
                        </DockPanel>
                    </Button>

                    <!-- 優先度 -->
                    <Button x:Name="PriorityRow" Style="{StaticResource DetailRowButtonStyle}" Click="OnPriorityClick"
                            AutomationProperties.Name="優先度を変える">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Width="15" TextAlignment="Center" VerticalAlignment="Center"
                                       Style="{StaticResource RowPriorityStyle}" Text="{Binding PrioritySymbol}" />
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource DetailLabelStyle}" Text="優先度" />
                            <TextBlock Style="{StaticResource DetailPriorityValueStyle}" Text="{Binding PriorityText}" />
                        </DockPanel>
                    </Button>

                    <!-- プロジェクト -->
                    <Button x:Name="ProjectRow" Style="{StaticResource DetailRowButtonStyle}" Click="OnProjectClick"
                            AutomationProperties.Name="プロジェクトを変える">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="15">
                                <Ellipse Style="{StaticResource ProjectDotStyle}" HorizontalAlignment="Center"
                                         Fill="{Binding ProjectColorHex, Converter={StaticResource HexBrush}}" />
                            </Grid>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource DetailLabelStyle}" Text="プロジェクト" />
                            <TextBlock Style="{StaticResource DetailValueStyle}" Text="{Binding ProjectText}" />
                        </DockPanel>
                    </Button>

                    <!-- タグ（チップ＋入力。Enter で追加、無ければ作る。× で外す） -->
                    <DockPanel Margin="0,4,0,4">
                        <TextBlock DockPanel.Dock="Left" Width="15" TextAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0"
                                   Style="{StaticResource TextBodySmallStyle}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" Text="#" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource DetailLabelStyle}" VerticalAlignment="Top" Margin="10,7,10,0" Text="タグ" />
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Tags}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TagChipBorderStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource RowChipTextStyle}"
                                                           FontSize="{StaticResource TypeCaptionSize}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Text="{Binding Name}" />
                                                <Button Style="{StaticResource IconButtonStyle}"
                                                        Width="20" Height="20" Margin="4,0,0,0"
                                                        AutomationProperties.Name="{Binding RemoveName}"
                                                        ToolTip="{Binding RemoveName}"
                                                        Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Viewbox Width="10" Height="10">
                                                        <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconClose}" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="2" />
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid>
                                <TextBox x:Name="TagBox"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         MinHeight="0"
                                         Height="30"
                                         input:ImeGuard.IsEnabled="True"
                                         AutomationProperties.Name="タグを追加"
                                         Text="{Binding TagInput, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="OnTagKeyDown"
                                         TextChanged="OnTagTextChanged"
                                         GotKeyboardFocus="OnTagGotFocus"
                                         LostKeyboardFocus="OnTagLostFocus" />
                                <TextBlock Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="9,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Text="タグを追加">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBodySmallStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TagBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </DockPanel>

                    <!-- 繰り返し -->
                    <Button x:Name="RecurrenceRow" Style="{StaticResource DetailRowButtonStyle}" Click="OnRecurrenceClick"
                            AutomationProperties.Name="繰り返しを変える">
                        <DockPanel>
                            <Viewbox DockPanel.Dock="Left" Style="{StaticResource DetailIconBoxStyle}">
                                <Path Style="{StaticResource DetailIconStyle}" Data="{StaticResource IconRepeat}" />
                            </Viewbox>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource DetailLabelStyle}" Text="繰り返し" />
                            <TextBlock Style="{StaticResource DetailValueStyle}" Text="{Binding RecurrenceText}" />
                        </DockPanel>
                    </Button>

                    <!-- 通知（期限からの相対なので、期限が無いときは選べない） -->
                    <Button x:Name="ReminderRow" Style="{StaticResource DetailRowButtonStyle}" Click="OnReminderClick"
                            IsEnabled="{Binding CanSetReminder}"
                            ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="通知を変える">
                        <Button.ToolTip>
                            <ToolTip Content="期限を入れると通知を付けられます" />
                        </Button.ToolTip>
                        <DockPanel>
                            <Viewbox DockPanel.Dock="Left" Style="{StaticResource DetailIconBoxStyle}">
                                <Path Style="{StaticResource DetailIconStyle}" Data="{StaticResource IconReminder}" />
                            </Viewbox>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource DetailLabelStyle}" Text="通知" />
                            <TextBlock Style="{StaticResource DetailValueStyle}" Text="{Binding ReminderText}" />
                        </DockPanel>
                    </Button>

                    <!-- 所要時間 -->
                    <Button x:Name="DurationRow" Style="{StaticResource DetailRowButtonStyle}" Click="OnDurationClick"
                            AutomationProperties.Name="所要時間を変える">
                        <DockPanel>
                            <Viewbox DockPanel.Dock="Left" Style="{StaticResource DetailIconBoxStyle}">
                                <Path Style="{StaticResource DetailIconStyle}" Data="{StaticResource IconDuration}" />
                            </Viewbox>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource DetailLabelStyle}" Text="所要時間" />
                            <TextBlock Style="{StaticResource DetailValueStyle}" Text="{Binding DurationText}" />
                        </DockPanel>
                    </Button>
                </StackPanel>

                <!-- サブタスク（進捗・完了切替・追加 F-021〜F-023）。3階層目では足せないので、子が無ければ欄ごと出さない -->
                <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowSubtaskSection, Converter={StaticResource BoolVisibility}}">
                    <Border Height="1" Background="{DynamicResource StrokeSubtleBrush}" Margin="0,0,0,14" />
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource TextCaptionStyle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Text="サブタスク" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource TabularCaptionStyle}" Margin="8,0,8,0" Text="{Binding SubtaskProgressText}"
                                   Visibility="{Binding HasSubtasks, Converter={StaticResource BoolVisibility}}" />
                        <ProgressBar Height="3" Minimum="0" Maximum="1" Value="{Binding SubtaskProgressValue, Mode=OneWay}"
                                     Background="{DynamicResource StrokeSubtleBrush}"
                                     Foreground="{DynamicResource AccentDefaultBrush}"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     AutomationProperties.Name="サブタスクの進み具合"
                                     Visibility="{Binding HasSubtasks, Converter={StaticResource BoolVisibility}}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Subtasks}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Height="30">
                                    <CheckBox DockPanel.Dock="Left"
                                              Style="{StaticResource SubtaskCheckBoxStyle}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,9,0"
                                              IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                              AutomationProperties.Name="{Binding Title}"
                                              Command="{Binding DataContext.ToggleSubtaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}" />
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBodySmallStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- サブタスクを追加（IME の変換確定 Enter では足さない。足したら欄は空にして残る。文字があるときは「追加」ボタンも出す） -->
                    <DockPanel Margin="0,4,0,0" Visibility="{Binding CanAddSubtask, Converter={StaticResource BoolVisibility}}">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinHeight="0" Height="28" Padding="10,0" Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Content="追加"
                                AutomationProperties.Name="入力したサブタスクを追加"
                                Click="OnAddSubtaskClick"
                                Visibility="{Binding HasSubtaskInput, Converter={StaticResource BoolVisibility}}" />
                        <Grid>
                            <TextBox x:Name="SubtaskBox"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     MinHeight="0"
                                     Height="30"
                                     Padding="26,0,8,0"
                                     input:ImeGuard.IsEnabled="True"
                                     AutomationProperties.Name="サブタスクを追加"
                                     Text="{Binding SubtaskInput, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="OnSubtaskKeyDown" />
                            <Viewbox Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False">
                                <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconAdd}" Stroke="{DynamicResource TextTertiaryBrush}" />
                            </Viewbox>
                            <TextBlock Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="27,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Text="サブタスクを追加">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBodySmallStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SubtaskBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 下部: 作成・更新日時と、その他の操作（行の右クリックメニューと同じ）・削除（Delete キーと同じ。取り消しトーストが出る） -->
        <DockPanel Grid.Row="1" Margin="18,6,10,10">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource IconButtonStyle}"
                    AutomationProperties.Name="タスクを削除"
                    ToolTip="削除（Delete）"
                    Command="{Binding DeleteCommand}">
                <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconTrash}" Stroke="{DynamicResource TextSecondaryBrush}" />
            </Button>
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource IconButtonStyle}"
                    Margin="0,0,2,0"
                    AutomationProperties.Name="このタスクのその他の操作"
                    ToolTip="その他の操作（一覧で右クリックしても出ます）"
                    Click="OnMoreActionsClick">
                <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconMore}" Stroke="{DynamicResource TextSecondaryBrush}" />
            </Button>
            <TextBlock Style="{StaticResource TextLabelStyle}"
                       FontWeight="Normal"
                       VerticalAlignment="Center"
                       Typography.NumeralAlignment="Tabular"
                       Text="{Binding CreatedUpdatedText}" />
        </DockPanel>

        <!-- 入力補助ポップアップ（中身は 1-D / 2-F。INTERFACES 5.3 の約束どおりに入れるだけ） -->
        <Popup x:Name="StatusPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PreviewKeyDown="OnPopupKeyDown">
            <Border Style="{StaticResource PopupShadowStyle}">
                <Border Style="{StaticResource PopupSurfaceStyle}" Width="{StaticResource SmallPopupWidth}" Padding="4">
                    <ItemsControl ItemsSource="{Binding StatusOptions}" ItemTemplate="{StaticResource StatusChoiceTemplate}" />
                </Border>
            </Border>
        </Popup>

        <!--
            ピッカー（1-D / 2-F）はパネル自身が影と面の枠と幅を持つ（INTERFACES 5.3 の補足）。ホストは Popup の直下に置くだけ。
            影の余白（左右10・上8）のぶん位置をずらす。開くとパネルが自分でフォーカスを取る（ここでは横取りしない）
        -->
        <Popup x:Name="DuePopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-10" VerticalOffset="-8">
            <pickers:DatePickerPanel x:Name="DatePicker" />
        </Popup>

        <Popup x:Name="PriorityPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-10" VerticalOffset="-8">
            <pickers:PriorityPickerPanel x:Name="PriorityPicker" />
        </Popup>

        <Popup x:Name="ProjectPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-10" VerticalOffset="-8">
            <pickers:ProjectPickerPanel x:Name="ProjectPicker" />
        </Popup>

        <Popup x:Name="RecurrencePopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-10" VerticalOffset="-8">
            <pickers:RecurrencePickerPanel x:Name="RecurrencePicker" />
        </Popup>

        <Popup x:Name="ReminderPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PreviewKeyDown="OnPopupKeyDown">
            <Border Style="{StaticResource PopupShadowStyle}">
                <Border Style="{StaticResource PopupSurfaceStyle}" Width="{StaticResource SmallPopupWidth}" Padding="4">
                    <ItemsControl ItemsSource="{Binding ReminderOptions}" ItemTemplate="{StaticResource ReminderChoiceTemplate}" />
                </Border>
            </Border>
        </Popup>

        <Popup x:Name="DurationPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PreviewKeyDown="OnPopupKeyDown">
            <Border Style="{StaticResource PopupShadowStyle}">
                <Border Style="{StaticResource PopupSurfaceStyle}" Width="{StaticResource SmallPopupWidth}" Padding="4">
                    <ItemsControl ItemsSource="{Binding DurationOptions}" ItemTemplate="{StaticResource DurationChoiceTemplate}" />
                </Border>
            </Border>
        </Popup>

        <!-- タグの候補。候補のボタンはフォーカスを取らない（押した瞬間に入力欄のフォーカスが外れて閉じないように） -->
        <Popup x:Name="TagSuggestionPopup"
               PlacementTarget="{Binding ElementName=TagBox}"
               Placement="Bottom"
               StaysOpen="True"
               AllowsTransparency="True"
               IsOpen="{Binding IsTagSuggestionOpen, Mode=OneWay}">
            <Border Style="{StaticResource PopupShadowStyle}">
                <Border Style="{StaticResource PopupSurfaceStyle}" MinWidth="{StaticResource SmallPopupWidth}" Padding="4">
                    <ItemsControl ItemsSource="{Binding TagSuggestions}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MenuChoiceButtonStyle}"
                                        Focusable="False"
                                        Content="{Binding Label}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Click="OnTagSuggestionClick" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Border>
        </Popup>
    </Grid>
</UserControl>
