<UserControl x:Class="TaskDeck.App.Views.Main.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:TaskDeck.App.Behaviors"
             xmlns:conv="clr-namespace:TaskDeck.App.Converters"
             xmlns:input="clr-namespace:TaskDeck.App.Input"
             xmlns:vm="clr-namespace:TaskDeck.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SidebarViewModel}"
             Background="Transparent">
    <UserControl.Resources>
        <conv:IconKeyToGeometryConverter x:Key="IconGeometry" />
        <conv:HexToBrushConverter x:Key="HexBrush" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />

        <!-- プロジェクトの右クリック: 名前を変更／色を変更（パレット6色）／アーカイブ／削除 -->
        <ContextMenu x:Key="ProjectContextMenu">
            <MenuItem Header="名前を変更" Command="{Binding BeginRenameCommand}" CommandParameter="{Binding}" />
            <MenuItem Header="色を変更" ItemsSource="{Binding ColorChoices}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Command" Value="{Binding Command}" />
                        <Setter Property="CommandParameter" Value="{Binding}" />
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                 Fill="{Binding Hex, Converter={StaticResource HexBrush}}" />
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <Separator />
            <MenuItem Header="アーカイブ" Command="{Binding ArchiveCommand}" CommandParameter="{Binding}" />
            <MenuItem Header="削除" Click="OnDeleteProject" />
        </ContextMenu>

        <!-- タグの右クリック: 名前を変更／削除／使っていないタグをまとめて削除（F-045） -->
        <ContextMenu x:Key="TagContextMenu">
            <MenuItem Header="名前を変更" Command="{Binding BeginRenameCommand}" CommandParameter="{Binding}" />
            <MenuItem Header="削除" Click="OnDeleteTag" />
            <Separator />
            <MenuItem Header="使っていないタグを削除" AutomationProperties.AutomationId="TagMenuDeleteUnused" Click="OnDeleteUnusedTags" />
        </ContextMenu>

        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:NavItemViewModel}">
            <Grid>
                <Border Style="{StaticResource NavSeparatorStyle}"
                        Visibility="{Binding IsSeparator, Converter={StaticResource BoolVisibility}}" />

                <!-- 見出し。「使い捨て」には右端に「＋」（新しい使い捨てリスト。最後に使った方＝メイン画面か小窓かで開く） -->
                <Grid Visibility="{Binding IsSection, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Style="{StaticResource NavSectionLabelStyle}" Text="{Binding Label}" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Width="24" Height="24"
                            Margin="0,0,6,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{Binding InvokeCommand}"
                            CommandParameter="{Binding}"
                            ToolTip="{Binding ActionName}"
                            AutomationProperties.Name="{Binding ActionName}"
                            Visibility="{Binding HasSectionAction, Converter={StaticResource BoolVisibility}}">
                        <Viewbox Width="12" Height="12">
                            <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconAdd}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8" />
                        </Viewbox>
                    </Button>
                </Grid>

                <Grid Visibility="{Binding IsRow, Converter={StaticResource BoolVisibility}}">
                    <!-- プロジェクト・タグにはタスクを落とせる（そのプロジェクトへ移す・そのタグを付ける UI 設計書 15.5） -->
                    <Button Height="{Binding RowHeight}"
                            Command="{Binding InvokeCommand}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Label}"
                            Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolVisibility}}"
                            DragOver="OnNavDragOver"
                            DragLeave="OnNavDragLeave"
                            Drop="OnNavDrop">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProject}" Value="True">
                                        <Setter Property="ContextMenu" Value="{StaticResource ProjectContextMenu}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTag}" Value="True">
                                        <Setter Property="ContextMenu" Value="{StaticResource TagContextMenu}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Border Style="{StaticResource NavSelectionBarStyle}" />
                            <DockPanel Margin="14,0,10,0">
                                <TextBlock DockPanel.Dock="Right"
                                           Style="{StaticResource NavCountStyle}"
                                           Text="{Binding Count}"
                                           Visibility="{Binding ShowCount, Converter={StaticResource BoolVisibility}}" />
                                <Path DockPanel.Dock="Left"
                                      Style="{StaticResource NavIconStyle}"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center"
                                      Data="{Binding IconKey, Converter={StaticResource IconGeometry}}"
                                      Visibility="{Binding HasIcon, Converter={StaticResource BoolVisibility}}" />
                                <Ellipse DockPanel.Dock="Left"
                                         Style="{StaticResource ProjectDotStyle}"
                                         Margin="3,0,13,0"
                                         Fill="{Binding ColorHex, Converter={StaticResource HexBrush}}"
                                         Visibility="{Binding IsProject, Converter={StaticResource BoolVisibility}}" />
                                <TextBlock DockPanel.Dock="Left"
                                           Width="15" Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           Style="{StaticResource TextBodySmallStyle}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Text="#"
                                           Visibility="{Binding IsTag, Converter={StaticResource BoolVisibility}}" />
                                <!-- 使い捨てリスト: 小さなチェックの箱（プロジェクトの点・タグの # と同じ幅） -->
                                <Border DockPanel.Dock="Left"
                                        Width="10" Height="10"
                                        Margin="2,0,13,0"
                                        VerticalAlignment="Center"
                                        CornerRadius="2.5"
                                        BorderThickness="1.3"
                                        BorderBrush="{DynamicResource TextTertiaryBrush}"
                                        Visibility="{Binding IsScratch, Converter={StaticResource BoolVisibility}}" />
                                <TextBlock Style="{StaticResource NavLabelStyle}" Text="{Binding Label}" />
                            </DockPanel>
                        </Grid>
                    </Button>

                    <!-- 名前の入力（追加・改名）。IME の変換確定 Enter では登録しない。フォーカスが外れたら確定 -->
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             Margin="10,2"
                             input:ImeGuard.IsEnabled="True"
                             behaviors:AutoFocus.WhenVisible="True"
                             AutomationProperties.Name="{Binding EditName}"
                             Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsEditing, Converter={StaticResource BoolVisibility}}"
                             PreviewKeyDown="OnEditKeyDown"
                             LostKeyboardFocus="OnEditLostFocus" />
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!--
        右端の 6px はスクロールバーの通り道（WPF-UI のスクロールバーは中身の上に重なり、件数を隠すため）。
        項目の右端はモックアップどおりサイドバーの右から 8px の位置になる
    -->
    <Grid Margin="8,8,2,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox x:Name="TopList"
                 Grid.Row="0"
                 Background="Transparent"
                 BorderThickness="0"
                 Focusable="False"
                 AutomationProperties.Name="ビュー"
                 ItemsSource="{Binding Items}"
                 ItemTemplate="{StaticResource NavItemTemplate}"
                 ItemContainerStyle="{StaticResource NavItemContainerStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel" />

        <Border Grid.Row="1" Style="{StaticResource NavSeparatorStyle}" Margin="10,8,16,6" />

        <ItemsControl Grid.Row="2"
                      Margin="0,0,6,0"
                      Focusable="False"
                      ItemsSource="{Binding BottomItems}"
                      ItemTemplate="{StaticResource NavItemTemplate}" />
    </Grid>
</UserControl>
