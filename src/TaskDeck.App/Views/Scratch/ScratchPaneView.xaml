<UserControl x:Class="TaskDeck.App.Views.Scratch.ScratchPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TaskDeck.App.Converters"
             xmlns:input="clr-namespace:TaskDeck.App.Input"
             xmlns:local="clr-namespace:TaskDeck.App.Views.Scratch"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:ScratchPaneViewModel}">
    <!--
        メイン画面の中央に出す使い捨てリスト（ビューが ViewKind.Scratch のとき）。
        見出し: 名前（押すとその場で変えられる）「（使い捨て）」＋残りの件数、右に「小窓で開く」。
        そのリストを小窓に出している間は、中身の代わりに「小窓で表示中［戻す］」。
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolVisibility" />
        <!-- 小窓に切り離す（四角から右上へ出る矢印） -->
        <StreamGeometry x:Key="ScratchIconPopOut">M9.5 2.5 h4 v4 M13.5 2.5 8 8 M11.5 9.5 v3 a1,1 0 0 1 -1,1 h-7 a1,1 0 0 1 -1,-1 v-7 a1,1 0 0 1 1,-1 h3</StreamGeometry>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="20,20,20,12" LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource ListToolbarButtonStyle}"
                    Margin="12,0,0,0"
                    VerticalAlignment="Bottom"
                    Command="{Binding DetachCommand}"
                    ToolTip="小窓に切り離して、ほかの作業の横に置いておく"
                    Visibility="{Binding IsDetached, Converter={StaticResource InverseBoolVisibility}}"
                    AutomationProperties.AutomationId="ScratchDetachButton"
                    AutomationProperties.Name="小窓で開く">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                        <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource ScratchIconPopOut}" />
                    </Viewbox>
                    <TextBlock Style="{StaticResource TextBodySmallStyle}" Margin="6,0,0,0" VerticalAlignment="Center" Text="小窓で開く" />
                </StackPanel>
            </Button>

            <StackPanel VerticalAlignment="Bottom" DataContext="{Binding List}">
                <StackPanel Orientation="Horizontal">
                    <!-- 名前（押すとその場で変えられる。打つたびにサイドバーにも出る。空にして離れたら元の名前に戻る） -->
                    <TextBox x:Name="NameBox"
                             Style="{StaticResource InlineTextBoxStyle}"
                             FontSize="{StaticResource TypeTitleSize}"
                             FontWeight="SemiBold"
                             MinWidth="40"
                             MaxWidth="460"
                             MaxLength="100"
                             Padding="2,0"
                             input:ImeGuard.IsEnabled="True"
                             Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="名前を変える"
                             PreviewKeyDown="OnNameKeyDown"
                             LostKeyboardFocus="OnNameLostFocus"
                             AutomationProperties.AutomationId="ScratchNameBox"
                             AutomationProperties.Name="リストの名前" />
                    <TextBlock Style="{StaticResource TextTitleStyle}"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center"
                               Text="（使い捨て）" />
                </StackPanel>
                <TextBlock Style="{StaticResource TextCaptionStyle}"
                           Margin="2,2,0,0"
                           Text="{Binding Summary}"
                           AutomationProperties.AutomationId="ScratchSummary" />
            </StackPanel>
        </DockPanel>

        <local:ScratchView x:Name="ListContent"
                           Grid.Row="1"
                           DataContext="{Binding List}"
                           Visibility="{Binding DataContext.IsDetached, RelativeSource={RelativeSource AncestorType=local:ScratchPaneView}, Converter={StaticResource InverseBoolVisibility}}" />

        <!-- 小窓で表示中 -->
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="360"
                    Visibility="{Binding IsDetached, Converter={StaticResource BoolVisibility}}">
            <Viewbox Width="34" Height="34" HorizontalAlignment="Center">
                <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource ScratchIconPopOut}" Stroke="{DynamicResource TextDisabledBrush}" StrokeThickness="1.2" />
            </Viewbox>
            <TextBlock Style="{StaticResource TextBodySmallStyle}"
                       Margin="0,12,0,0"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       Text="小窓で表示中"
                       AutomationProperties.AutomationId="ScratchDetachedTitle" />
            <TextBlock Style="{StaticResource TextCaptionStyle}"
                       Margin="0,8,0,0"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Text="このリストは小窓に出しています。戻すと小窓を閉じて、ここに出します。" />
            <Button Style="{StaticResource StandardButtonStyle}"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Center"
                    MinHeight="0" Height="28" Padding="14,0"
                    Content="戻す"
                    Command="{Binding AttachCommand}"
                    AutomationProperties.AutomationId="ScratchAttachButton"
                    AutomationProperties.Name="メイン画面に戻す" />
        </StackPanel>
    </Grid>
</UserControl>
