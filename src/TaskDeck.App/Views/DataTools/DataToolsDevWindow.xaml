<ui:FluentWindow x:Class="TaskDeck.App.Views.DataTools.DataToolsDevWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:TaskDeck.App.Controls"
                 xmlns:local="clr-namespace:TaskDeck.App.Views.DataTools"
                 xmlns:input="clr-namespace:TaskDeck.App.Input"
                 Title="TaskDeck DataTools（開発用）"
                 Width="820" Height="900"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowStartupLocation="CenterScreen"
                 Background="{DynamicResource SurfaceWindowBrush}">
    <!--
        開発用の確認窓（本番では開かない。DataToolsDevStartup を参照）。
        設定画面「データ」ページのカード（ImportExportPanel）と、一覧の見出しから開く絞り込み（FilterPanel）を、
        組み込み先と同じ形（カードはそのまま、絞り込みは Popup）で置いて確かめる。
    -->
    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource TextCaptionStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>
        <Style x:Key="DevButtonStyle" TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="データツール（開発用）" />

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceContentBrush}"
                BorderBrush="{DynamicResource StrokeDividerBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="{StaticResource RadiusContentTopLeft}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,22,26,26">
                    <TextBlock Style="{StaticResource TextTitleStyle}" Text="データ" />
                    <TextBlock Style="{StaticResource TextCaptionStyle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="設定画面「データ」ページとメイン画面に組み込む部品の確認用です（開発用データフォルダで TASKDECK_DEV_DATATOOLS を付けたときだけ開きます）。" />

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="複合絞り込み（一覧の見出しの「絞り込み」と同じく Popup で開く）" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="FilterButton" Style="{StaticResource StandardButtonStyle}" Click="OnOpenFilter" AutomationProperties.Name="絞り込み">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconFilter}" Margin="0,0,6,0" />
                                <TextBlock VerticalAlignment="Center" Text="絞り込み" />
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource TextCaptionStyle}" Margin="16,0,8,0" VerticalAlignment="Center" Text="検索語（そのまま残るか見る）" />
                        <TextBox x:Name="SearchBox"
                                 Width="200"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 input:ImeGuard.IsEnabled="True"
                                 AutomationProperties.Name="検索語"
                                 TextChanged="OnSearchChanged" />
                    </StackPanel>
                    <Popup x:Name="FilterPopup"
                           PlacementTarget="{Binding ElementName=FilterButton}"
                           Placement="Bottom"
                           HorizontalOffset="-12"
                           VerticalOffset="-6"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <controls:FilterPanel x:Name="Filter" Applied="OnFilterApplied" Cancelled="OnFilterCancelled" />
                    </Popup>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="インポート／エクスポート" />
                    <local:ImportExportPanel x:Name="Transfer" />

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="開発用（ファイルダイアログを通さずに既定のパスで）" />
                    <WrapPanel>
                        <Button Style="{StaticResource DevButtonStyle}" Content="既定のパスに JSON を書き出す" Click="OnDevExportJson" />
                        <Button Style="{StaticResource DevButtonStyle}" Content="既定のパスから追加で読み込む" Click="OnDevAppend" />
                        <Button Style="{StaticResource DevButtonStyle}" Content="既定のパスから置換で読み込む" Click="OnDevReplace" />
                        <Button Style="{StaticResource DevButtonStyle}" Content="既定のパスに CSV を書き出す" Click="OnDevExportCsv" />
                    </WrapPanel>
                    <TextBlock x:Name="TransferFolderText" Style="{StaticResource TextCaptionStyle}" TextWrapping="Wrap" />

                    <TextBlock Style="{StaticResource TextCaptionStyle}" Margin="0,12,0,4"
                               Text="いまの一覧の条件（適用すると ShellService.CurrentListQuery にも入れる＝CSV の「表示中の一覧」になる。開発用）" />
                    <TextBox x:Name="QueryText"
                             IsReadOnly="True"
                             FontFamily="{StaticResource KeyCapFontFamily}"
                             FontSize="{StaticResource TypeCaptionSize}"
                             TextWrapping="Wrap"
                             AutomationProperties.Name="いまの条件" />
                    <TextBlock x:Name="SavedFiltersText" Style="{StaticResource TextCaptionStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</ui:FluentWindow>
