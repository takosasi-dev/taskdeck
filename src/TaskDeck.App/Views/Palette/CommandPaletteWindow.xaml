<Window x:Class="TaskDeck.App.Views.Palette.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TaskDeck.App.Converters"
        xmlns:input="clr-namespace:TaskDeck.App.Input"
        xmlns:palette="clr-namespace:TaskDeck.App.Views.Palette"
        xmlns:pickers="clr-namespace:TaskDeck.App.Controls.Pickers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance palette:CommandPaletteViewModel}"
        Title="コマンドパレット"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <!-- コマンドパレット（S-07、UI 設計書 11.2）。幅 660・入力行 54・結果 1行40（8行ぶんでスクロール）・フッタ 34・角丸 10 -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <conv:IconKeyToGeometryConverter x:Key="IconGeometry" />
        <pickers:ProjectColorConverter x:Key="ProjectColor" />

        <!-- 入力欄（枠なし・16px。フォーカスの下線も出さない） -->
        <Style x:Key="PaletteInputStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentDefaultBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Style="{x:Null}"
                                      Focusable="False"
                                      Background="Transparent"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- キーの表記（「Ctrl+K」「Ctrl+Enter」） -->
        <Style x:Key="KeyHintBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeyHintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBaseStyle}">
            <Setter Property="FontFamily" Value="{StaticResource KeyCapFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource TypeLabelSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        </Style>

        <!--
            結果の1行（高さ 40）。キーボードのフォーカスは入力欄に置いたままにするので、行はフォーカスを取らない。
            選んでいる行は地を敷いて左端にアクセントの棒（モックアップの 3×20）。押すと実行する
        -->
        <Style x:Key="PaletteRowStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Command" Value="{Binding DataContext.ExecuteCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Back" Background="Transparent" />
                            <Border x:Name="Bar"
                                    Width="3" Height="20"
                                    HorizontalAlignment="Left"
                                    CornerRadius="2"
                                    Background="{DynamicResource AccentDefaultBrush}"
                                    Visibility="Collapsed" />
                            <ContentPresenter Margin="18,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- パレットの下の記号の案内（押すとその記号を入れる） -->
        <Style x:Key="PrefixChipStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip"
                                Height="26"
                                Padding="11,0"
                                CornerRadius="13"
                                Background="{DynamicResource SurfaceContentBrush}"
                                BorderBrush="{DynamicResource StrokeControlBrush}"
                                BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrefixSymbolStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBaseStyle}">
            <Setter Property="FontFamily" Value="{StaticResource KeyCapFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource TypeLabelSize}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PrefixLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBaseStyle}">
            <Setter Property="FontSize" Value="{StaticResource TypeLabelSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- フッタのキーヒント（「↑↓ 選択」） -->
        <Style x:Key="FooterHintStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBaseStyle}">
            <Setter Property="FontSize" Value="{StaticResource TypeLabelSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- セクションの見出し -->
        <DataTemplate DataType="{x:Type palette:PaletteHeaderRow}">
            <StackPanel>
                <Border Height="1"
                        Margin="18,6"
                        Background="{DynamicResource StrokeSubtleBrush}"
                        Visibility="{Binding HasDivider, Converter={StaticResource BoolVisibility}}" />
                <TextBlock Style="{StaticResource TextLabelStyle}"
                           Margin="18,2,18,4"
                           Text="{Binding Title}" />
            </StackPanel>
        </DataTemplate>

        <!-- 選べない案内（「ほか 120 件」） -->
        <DataTemplate DataType="{x:Type palette:PaletteNoteRow}">
            <TextBlock Style="{StaticResource TextCaptionStyle}"
                       Margin="18,6"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="{Binding Text}" />
        </DataTemplate>

        <!-- コマンド・移動・テンプレート・記号・「さらに N 件」 -->
        <DataTemplate DataType="{x:Type palette:PaletteItem}">
            <Button Style="{StaticResource PaletteRowStyle}">
                <DockPanel>
                    <Grid DockPanel.Dock="Left" MinWidth="16" Margin="0,0,11,0" VerticalAlignment="Center">
                        <Path x:Name="Icon"
                              Style="{StaticResource IconPathStyle}"
                              Data="{Binding IconKey, Converter={StaticResource IconGeometry}}"
                              Visibility="{Binding HasIcon, Converter={StaticResource BoolVisibility}}" />
                        <Ellipse Width="9" Height="9"
                                 HorizontalAlignment="Center"
                                 Fill="{Binding ColorHex, Converter={StaticResource ProjectColor}}"
                                 Visibility="{Binding HasColor, Converter={StaticResource BoolVisibility}}" />
                        <Border Style="{StaticResource KeyHintBorderStyle}"
                                Padding="6,1"
                                Visibility="{Binding IsPrefix, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Style="{StaticResource KeyHintTextStyle}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentDefaultBrush}"
                                       Text="{Binding PrefixSymbol}" />
                        </Border>
                    </Grid>
                    <Border DockPanel.Dock="Right"
                            Style="{StaticResource KeyHintBorderStyle}"
                            Margin="11,0,0,0"
                            Visibility="{Binding HasKeyHint, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Style="{StaticResource KeyHintTextStyle}" Text="{Binding KeyHint}" />
                    </Border>
                    <TextBlock DockPanel.Dock="Right"
                               Style="{StaticResource TabularCaptionStyle}"
                               FontSize="{StaticResource TypeLabelSize}"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               MaxWidth="200"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Detail}"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolVisibility}}" />
                    <TextBlock x:Name="Label"
                               Style="{StaticResource TextBodyStyle}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               palette:PaletteHighlight.Pieces="{Binding Pieces}" />
                </DockPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAccent}" Value="True">
                    <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource AccentDefaultBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static palette:PaletteItemKind.More}">
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentDefaultBrush}" />
                    <Setter TargetName="Label" Property="FontSize" Value="{StaticResource TypeBodySmallSize}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- タスク: チェック・優先度・タイトル・プロジェクト・期限（モックアップの 16 / 20 / * / チップ / 74） -->
        <DataTemplate DataType="{x:Type palette:PaletteTaskItem}">
            <Button Style="{StaticResource PaletteRowStyle}">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Left"
                              Style="{StaticResource TaskCheckBoxStyle}"
                              Width="16" Height="16"
                              Margin="0,0,11,0"
                              Focusable="False"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsClosed, Mode=OneWay}"
                              Checked="OnTaskCheckChanged"
                              Unchecked="OnTaskCheckChanged"
                              AutomationProperties.Name="{Binding CheckName}" />
                    <TextBlock x:Name="Priority"
                               DockPanel.Dock="Left"
                               Width="20"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource TypeLabelSize}"
                               FontWeight="Bold"
                               Text="{Binding PrioritySymbol}" />
                    <TextBlock x:Name="Due"
                               DockPanel.Dock="Right"
                               Style="{StaticResource TabularCaptionStyle}"
                               Width="74"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Text="{Binding DueText}" />
                    <TextBlock DockPanel.Dock="Right"
                               Style="{StaticResource TextCaptionStyle}"
                               FontSize="{StaticResource TypeLabelSize}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding ClosedText}"
                               Visibility="{Binding IsClosed, Converter={StaticResource BoolVisibility}}" />
                    <Border x:Name="ProjectChip"
                            DockPanel.Dock="Right"
                            Margin="11,0,0,0"
                            Padding="7,2"
                            CornerRadius="10"
                            VerticalAlignment="Center"
                            MaxWidth="160"
                            Background="{DynamicResource SurfaceSubtleBrush}"
                            Visibility="{Binding HasProject, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Style="{StaticResource TextCaptionStyle}"
                                   FontSize="{StaticResource TypeLabelSize}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding ProjectName}" />
                    </Border>
                    <TextBlock x:Name="Title"
                               Style="{StaticResource TextBodyStyle}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               palette:PaletteHighlight.Pieces="{Binding Pieces}" />
                </DockPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Priority}" Value="Urgent">
                    <Setter TargetName="Priority" Property="Foreground" Value="{DynamicResource PriorityUrgentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="High">
                    <Setter TargetName="Priority" Property="Foreground" Value="{DynamicResource PriorityHighBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="Medium">
                    <Setter TargetName="Priority" Property="Foreground" Value="{DynamicResource PriorityMediumBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="Low">
                    <Setter TargetName="Priority" Property="Foreground" Value="{DynamicResource PriorityLowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDueStrong}" Value="True">
                    <Setter TargetName="Due" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Due" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter TargetName="Due" Property="Foreground" Value="{DynamicResource StateOverdueBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsClosed}" Value="True">
                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                    <Setter TargetName="Title" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="Due" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                    <Setter TargetName="Due" Property="FontWeight" Value="Normal" />
                    <Setter TargetName="ProjectChip" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <StackPanel>
        <Border Style="{StaticResource PopupShadowStyle}" CornerRadius="11">
            <Border Style="{StaticResource PopupSurfaceStyle}"
                    Width="{StaticResource PaletteWidth}"
                    CornerRadius="{StaticResource RadiusDialog}">
                <StackPanel>
                    <!-- 入力行 -->
                    <Grid Height="54" Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                            <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextTertiaryBrush}" />
                        </Viewbox>
                        <!-- Tab で絞り込んだプロジェクト／タグ（Backspace で外す） -->
                        <Border Grid.Column="1"
                                Height="26"
                                Margin="12,0,0,0"
                                Padding="9,0"
                                CornerRadius="13"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SurfaceSelectedBrush}"
                                BorderBrush="{DynamicResource SurfaceSelectedStrokeBrush}"
                                BorderThickness="1"
                                AutomationProperties.AutomationId="PaletteScope"
                                Visibility="{Binding HasScope, Converter={StaticResource BoolVisibility}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding Scope.ColorHex, Converter={StaticResource ProjectColor}}"
                                         Visibility="{Binding Scope.IsProject, Converter={StaticResource BoolVisibility}, FallbackValue=Collapsed}" />
                                <TextBlock Style="{StaticResource TextBodySmallStyle}"
                                           VerticalAlignment="Center"
                                           Text="{Binding Scope.Label}" />
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="2"
                                 Margin="12,0"
                                 Style="{StaticResource PaletteInputStyle}"
                                 input:ImeGuard.IsEnabled="True"
                                 AutomationProperties.AutomationId="PaletteInput"
                                 AutomationProperties.Name="タスク・コマンドを探す"
                                 TextChanged="OnSearchTextChanged"
                                 PreviewTextInput="OnSearchPreviewTextInput" />
                        <TextBlock Grid.Column="2"
                                   Margin="14,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   FontSize="16"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="タスク・コマンド・プロジェクトを探す"
                                   Visibility="{Binding IsInputEmpty, Converter={StaticResource BoolVisibility}}" />
                        <Border Grid.Column="3" Style="{StaticResource KeyHintBorderStyle}" Padding="8,3">
                            <TextBlock Style="{StaticResource KeyHintTextStyle}" Text="Ctrl+K" />
                        </Border>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource StrokeDividerBrush}" />

                    <!-- 結果 -->
                    <ItemsControl x:Name="ResultList"
                                  ItemsSource="{Binding Rows}"
                                  Focusable="False"
                                  MaxHeight="420"
                                  AutomationProperties.AutomationId="PaletteResults">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer x:Name="PART_Scroll"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter Margin="0,6" />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                    </ItemsControl>
                    <StackPanel Margin="18,18"
                                Visibility="{Binding HasNoResults, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Style="{StaticResource TextBodySmallStyle}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   AutomationProperties.AutomationId="PaletteEmpty"
                                   Text="一致するものはありません" />
                        <TextBlock Style="{StaticResource TextCaptionStyle}"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="記号を消すと、タスク・コマンド・移動先をまとめて探せます" />
                    </StackPanel>

                    <!-- フッタ（キーヒントと件数・知らせ） -->
                    <Border Height="34"
                            Background="{DynamicResource SurfaceSubtleBrush}"
                            BorderBrush="{DynamicResource StrokeDividerBrush}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,9,9">
                        <DockPanel Margin="18,0">
                            <TextBlock DockPanel.Dock="Right"
                                       Style="{StaticResource TabularCaptionStyle}"
                                       FontSize="{StaticResource TypeLabelSize}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"
                                       MaxWidth="300"
                                       TextTrimming="CharacterEllipsis"
                                       AutomationProperties.AutomationId="PaletteFooter"
                                       Text="{Binding FooterText}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource FooterHintStyle}"><Run FontWeight="SemiBold" Text="↑↓" /><Run Text=" 選択" /></TextBlock>
                                <TextBlock Style="{StaticResource FooterHintStyle}"><Run FontWeight="SemiBold" Text="Enter" /><Run Text=" " /><Run Text="{Binding EnterHint, Mode=OneWay}" /></TextBlock>
                                <TextBlock Style="{StaticResource FooterHintStyle}"
                                           Visibility="{Binding IsTaskSelected, Converter={StaticResource BoolVisibility}}"><Run FontWeight="SemiBold" Text="Space" /><Run Text=" 完了" /></TextBlock>
                                <TextBlock Style="{StaticResource FooterHintStyle}"
                                           Visibility="{Binding CanNarrow, Converter={StaticResource BoolVisibility}}"><Run FontWeight="SemiBold" Text="Tab" /><Run Text=" 絞り込む" /></TextBlock>
                                <TextBlock Style="{StaticResource FooterHintStyle}"
                                           Visibility="{Binding CanCreate, Converter={StaticResource BoolVisibility}}"><Run FontWeight="SemiBold" Text="Ctrl+Enter" /><Run Text=" 作成" /></TextBlock>
                                <TextBlock Style="{StaticResource FooterHintStyle}"><Run FontWeight="SemiBold" Text="Esc" /><Run Text=" " /><Run Text="{Binding EscHint, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Border>

        <!-- 絞り込み記号の案内（UI 設計書 11.3） -->
        <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,8">
            <Button Style="{StaticResource PrefixChipStyle}" Tag="&gt;" Click="OnPrefixClick" AutomationProperties.Name="コマンドだけ">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource PrefixSymbolStyle}" Text="&gt;" /><TextBlock Style="{StaticResource PrefixLabelStyle}" Text="コマンドだけ" /></StackPanel>
            </Button>
            <Button Style="{StaticResource PrefixChipStyle}" Tag="#" Click="OnPrefixClick" AutomationProperties.Name="タグ">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource PrefixSymbolStyle}" Text="#" /><TextBlock Style="{StaticResource PrefixLabelStyle}" Text="タグ" /></StackPanel>
            </Button>
            <Button Style="{StaticResource PrefixChipStyle}" Tag="@" Click="OnPrefixClick" AutomationProperties.Name="プロジェクト">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource PrefixSymbolStyle}" Text="@" /><TextBlock Style="{StaticResource PrefixLabelStyle}" Text="プロジェクト" /></StackPanel>
            </Button>
            <Button Style="{StaticResource PrefixChipStyle}" Tag="/" Click="OnPrefixClick" AutomationProperties.Name="ビュー移動">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource PrefixSymbolStyle}" Text="/" /><TextBlock Style="{StaticResource PrefixLabelStyle}" Text="ビュー移動" /></StackPanel>
            </Button>
            <Button Style="{StaticResource PrefixChipStyle}" Tag="+" Click="OnPrefixClick" AutomationProperties.Name="テンプレート">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource PrefixSymbolStyle}" Text="+" /><TextBlock Style="{StaticResource PrefixLabelStyle}" Text="テンプレート" /></StackPanel>
            </Button>
            <Button Style="{StaticResource PrefixChipStyle}" Tag="?" Click="OnPrefixClick" AutomationProperties.Name="ヘルプ">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource PrefixSymbolStyle}" Text="?" /><TextBlock Style="{StaticResource PrefixLabelStyle}" Text="ヘルプ" /></StackPanel>
            </Button>
        </WrapPanel>
    </StackPanel>
</Window>
