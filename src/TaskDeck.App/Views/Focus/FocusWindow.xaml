<Window x:Class="TaskDeck.App.Views.Focus.FocusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TaskDeck.App.Converters"
        xmlns:focus="clr-namespace:TaskDeck.App.Views.Focus"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance focus:FocusViewModel}"
        Title="フォーカスモード"
        Width="900" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        InputMethod.IsInputMethodEnabled="False"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <!--
        フォーカスモード（S-14、UI 設計書 25）。900×640・角丸 12・暗い面（Splash.Background）・左右の余白 64・タイトル 36px・上端 3px の進捗。
        面はテーマに関わらず暗いので、文字は Toast.Foreground（白）を不透明度で濃淡にし、暗い面に合わない色はここで上書きする
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolVisibility" />
        <conv:HexToBrushConverter x:Key="HexToBrush" />

        <!-- 暗い面の上の色（ダークテーマと同じ値。ライトテーマのままだと暗い面で読めない色だけ上書きする） -->
        <SolidColorBrush x:Key="FocusOverdueBrush" Color="#FFFF6B5E" />
        <SolidColorBrush x:Key="FocusPriorityUrgentBrush" Color="#FFFF6B5E" />
        <SolidColorBrush x:Key="FocusPriorityHighBrush" Color="#FFFF8C42" />
        <SolidColorBrush x:Key="FocusPriorityMediumBrush" Color="#FFFFC83D" />
        <SolidColorBrush x:Key="FocusPriorityLowBrush" Color="#FF4CC2FF" />
        <!-- チェックボックスの枠とホバー・アイコンボタンのホバー（TaskCheckBoxStyle などが参照するキーを、この窓の中だけ暗い面に合わせる） -->
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FF262A30" />
        <SolidColorBrush x:Key="StrokeControlStrongBrush" Color="#FF7C7C7C" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFC8CCD2" />

        <Style x:Key="FocusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBaseStyle}">
            <Setter Property="Foreground" Value="{DynamicResource ToastForegroundBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FocusDimTextStyle" TargetType="TextBlock" BasedOn="{StaticResource FocusTextStyle}">
            <Setter Property="FontSize" Value="{StaticResource TypeCaptionSize}" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- 「完了して次へ」（アクセント地・高さ 42） -->
        <Style x:Key="FocusPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <!-- 「今はやらない」（白の 6% の地と 12% の枠） -->
        <Style x:Key="FocusSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- 中の文字はボタンから色を受け継ぐ（論理ツリー）ので、ボタンに白を入れる -->
            <Setter Property="Foreground" Value="{DynamicResource ToastForegroundBrush}" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Fill" CornerRadius="6" Background="{DynamicResource ToastForegroundBrush}" Opacity="0.06" />
                            <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ToastForegroundBrush}" Opacity="0.12" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Opacity="0.8" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.12" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下のキーヒント（「Space 完了」） -->
        <Style x:Key="FocusHintStyle" TargetType="TextBlock" BasedOn="{StaticResource FocusTextStyle}">
            <Setter Property="FontSize" Value="{StaticResource TypeLabelSize}" />
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Margin" Value="14,0,0,0" />
        </Style>

        <!-- サブタスク1行（チェック 17px・文字 15px） -->
        <DataTemplate DataType="{x:Type focus:FocusSubtask}">
            <DockPanel Height="34">
                <CheckBox DockPanel.Dock="Left"
                          Style="{StaticResource TaskCheckBoxStyle}"
                          Focusable="False"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsDone, Mode=OneWay}"
                          Checked="OnSubtaskCheckChanged"
                          Unchecked="OnSubtaskCheckChanged"
                          AutomationProperties.Name="{Binding CheckName}" />
                <TextBlock x:Name="SubtaskTitle"
                           Style="{StaticResource FocusTextStyle}"
                           Margin="12,0,0,0"
                           FontSize="15"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Title}" />
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="SubtaskTitle" Property="Opacity" Value="0.35" />
                    <Setter TargetName="SubtaskTitle" Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- いま出している1件（プロジェクト・優先度・タグ → タイトル → 期限と残り時間 → メモの頭 → サブタスク） -->
        <DataTemplate DataType="{x:Type focus:FocusCard}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Visibility="{Binding HasMeta, Converter={StaticResource BoolVisibility}}">
                    <Grid Height="24" Margin="0,0,10,0" Visibility="{Binding HasProject, Converter={StaticResource BoolVisibility}}">
                        <Border CornerRadius="12" Background="{DynamicResource ToastForegroundBrush}" Opacity="0.07" />
                        <StackPanel Orientation="Horizontal" Margin="10,0">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding ProjectColorHex, Converter={StaticResource HexToBrush}}" />
                            <TextBlock Style="{StaticResource FocusTextStyle}"
                                       FontSize="{StaticResource TypeLabelSize}"
                                       Opacity="0.8"
                                       AutomationProperties.AutomationId="FocusProject"
                                       Text="{Binding ProjectName}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="Priority"
                               Style="{StaticResource FocusTextStyle}"
                               Margin="0,0,10,0"
                               FontSize="{StaticResource TypeLabelSize}"
                               FontWeight="Bold"
                               Text="{Binding PrioritySymbol}" />
                    <TextBlock Style="{StaticResource FocusTextStyle}"
                               FontSize="{StaticResource TypeLabelSize}"
                               Opacity="0.5"
                               Text="{Binding TagsText}" />
                </StackPanel>

                <TextBlock Style="{StaticResource FocusTextStyle}"
                           FontSize="36"
                           FontWeight="SemiBold"
                           LineHeight="47"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="141"
                           AutomationProperties.AutomationId="FocusTitle"
                           Text="{Binding Title}" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding HasDue, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Style="{StaticResource FocusTextStyle}"
                               FontSize="{StaticResource TypeBodySize}"
                               Opacity="0.8"
                               AutomationProperties.AutomationId="FocusDue"
                               Text="{Binding DueLabel}" />
                    <Ellipse Width="3" Height="3" Margin="10,0" VerticalAlignment="Center" Fill="{DynamicResource ToastForegroundBrush}" Opacity="0.3" />
                    <TextBlock x:Name="Remaining"
                               Style="{StaticResource FocusTextStyle}"
                               FontSize="{StaticResource TypeBodySize}"
                               Foreground="{DynamicResource FocusRemainingBrush}"
                               AutomationProperties.AutomationId="FocusRemainingTime"
                               Text="{Binding RemainingLabel}" />
                </StackPanel>

                <TextBlock Style="{StaticResource FocusTextStyle}"
                           Margin="0,18,0,0"
                           MaxWidth="620"
                           MaxHeight="72"
                           HorizontalAlignment="Left"
                           FontSize="{StaticResource TypeBodySize}"
                           LineHeight="24"
                           Opacity="0.55"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding NotesHead}"
                           Visibility="{Binding HasNotes, Converter={StaticResource BoolVisibility}}" />

                <StackPanel MaxWidth="620" HorizontalAlignment="Left" Visibility="{Binding HasSubtasks, Converter={StaticResource BoolVisibility}}">
                    <Border Width="620" Height="1" Margin="0,26,0,20" Background="{DynamicResource ToastForegroundBrush}" Opacity="0.08" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource FocusDimTextStyle}" Text="サブタスク" />
                        <TextBlock Style="{StaticResource FocusTextStyle}"
                                   Margin="10,0"
                                   FontSize="{StaticResource TypeCaptionSize}"
                                   Opacity="0.8"
                                   Typography.NumeralAlignment="Tabular"
                                   AutomationProperties.AutomationId="FocusSubtaskProgress"
                                   Text="{Binding SubtaskProgress}" />
                        <Grid Width="120" Height="3" VerticalAlignment="Center">
                            <Border CornerRadius="2" Background="{DynamicResource ToastForegroundBrush}" Opacity="0.1" />
                            <Border CornerRadius="2" Background="{DynamicResource ToastActionBrush}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding SubtaskRatio}" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <!-- ponytail: サブタスクは多くて十数件なので仮想化しない。8行を超えたらこの中でスクロールする -->
                    <ItemsControl ItemsSource="{Binding Subtasks}" Focusable="False" MaxHeight="190" AutomationProperties.AutomationId="FocusSubtasks">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Priority}" Value="Urgent">
                    <Setter TargetName="Priority" Property="Foreground" Value="{DynamicResource FocusPriorityUrgentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="High">
                    <Setter TargetName="Priority" Property="Foreground" Value="{DynamicResource FocusPriorityHighBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="Medium">
                    <Setter TargetName="Priority" Property="Foreground" Value="{DynamicResource FocusPriorityMediumBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="Low">
                    <Setter TargetName="Priority" Property="Foreground" Value="{DynamicResource FocusPriorityLowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter TargetName="Remaining" Property="Foreground" Value="{DynamicResource FocusOverdueBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="12" Background="{DynamicResource SplashBackgroundBrush}">
        <Grid>
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,900,640" RadiusX="12" RadiusY="12" />
            </Grid.Clip>
            <Grid.RowDefinitions>
                <RowDefinition Height="3" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 上端の今日の完了率（F-175）。ProgressBar にしておくと読み上げで値が取れる -->
            <ProgressBar Grid.Row="0"
                         Height="3"
                         Minimum="0"
                         Maximum="1"
                         Focusable="False"
                         Value="{Binding Progress, Mode=OneWay}"
                         AutomationProperties.AutomationId="FocusProgress"
                         AutomationProperties.Name="{Binding ProgressText}">
                <ProgressBar.Template>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{DynamicResource ToastForegroundBrush}" Opacity="0.08" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource AccentDefaultBrush}" />
                        </Grid>
                    </ControlTemplate>
                </ProgressBar.Template>
            </ProgressBar>

            <!-- 上の行（残りの数・何件目・閉じる）。ここを持って窓を動かせる -->
            <DockPanel Grid.Row="1" Margin="32,20,20,0" Background="Transparent" MouseLeftButtonDown="OnDragAreaMouseDown">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource IconButtonStyle}"
                        Width="28" Height="28"
                        Focusable="False"
                        AutomationProperties.Name="フォーカスモードを終了"
                        Click="OnCloseClick">
                    <Viewbox Width="11" Height="11">
                        <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconClose}" Stroke="{DynamicResource ToastForegroundBrush}" Opacity="0.45" />
                    </Viewbox>
                </Button>
                <TextBlock DockPanel.Dock="Right"
                           Style="{StaticResource FocusDimTextStyle}"
                           Margin="0,0,12,0"
                           Typography.NumeralAlignment="Tabular"
                           AutomationProperties.AutomationId="FocusPosition"
                           Text="{Binding PositionText}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolVisibility}}" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolVisibility}}">
                    <Viewbox Width="14" Height="14" Margin="0,0,8,0">
                        <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconToday}" Stroke="{DynamicResource ToastForegroundBrush}" Opacity="0.4" />
                    </Viewbox>
                    <TextBlock Style="{StaticResource FocusDimTextStyle}"
                               Typography.NumeralAlignment="Tabular"
                               AutomationProperties.AutomationId="FocusRemaining"
                               Text="{Binding RemainingText}" />
                </StackPanel>
            </DockPanel>

            <!-- いま出している1件 -->
            <ContentControl Grid.Row="2"
                            Margin="64,0"
                            VerticalAlignment="Center"
                            Focusable="False"
                            Content="{Binding Current}"
                            Visibility="{Binding HasCurrent, Converter={StaticResource BoolVisibility}}" />

            <!-- 今日のタスクが無い -->
            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
                <TextBlock Style="{StaticResource FocusTextStyle}"
                           HorizontalAlignment="Center"
                           FontSize="{StaticResource TypeTitleSize}"
                           FontWeight="SemiBold"
                           AutomationProperties.AutomationId="FocusEmpty"
                           Text="今日やることはありません" />
                <TextBlock Style="{StaticResource FocusTextStyle}"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           FontSize="{StaticResource TypeBodySize}"
                           Opacity="0.55"
                           Text="期限が今日までの未完了のタスクはありません。Esc で戻ります" />
            </StackPanel>

            <!-- 今日の分を全部片づけた -->
            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsFinished, Converter={StaticResource BoolVisibility}}">
                <Viewbox Width="44" Height="44" HorizontalAlignment="Center">
                    <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconCheckCircle}" Stroke="{DynamicResource ToastActionBrush}" />
                </Viewbox>
                <TextBlock Style="{StaticResource FocusTextStyle}"
                           Margin="0,18,0,0"
                           HorizontalAlignment="Center"
                           FontSize="{StaticResource TypeTitleSize}"
                           FontWeight="SemiBold"
                           AutomationProperties.AutomationId="FocusFinished"
                           Text="今日の分はすべて片づきました" />
                <TextBlock Style="{StaticResource FocusTextStyle}"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           FontSize="{StaticResource TypeBodySize}"
                           Opacity="0.55"
                           Text="{Binding FinishedText}" />
            </StackPanel>

            <!-- 下の行（ボタンとキーヒント） -->
            <DockPanel Grid.Row="3" Margin="64,0,64,30" Height="42">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Visibility="{Binding HasCurrent, Converter={StaticResource BoolVisibility}}">
                    <Button Style="{StaticResource FocusPrimaryButtonStyle}" AutomationProperties.Name="完了して次へ" Click="OnCompleteClick">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,9,0">
                                <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconCheck}" Stroke="{DynamicResource TextOnAccentBrush}" StrokeThickness="1.9" />
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center" Text="完了して次へ" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FocusSecondaryButtonStyle}" Margin="12,0,0,0" AutomationProperties.Name="今はやらない" Click="OnSkipClick">
                        <TextBlock Text="今はやらない" />
                    </Button>
                </StackPanel>
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource FocusSecondaryButtonStyle}"
                        AutomationProperties.Name="閉じる"
                        Click="OnCloseClick"
                        Visibility="{Binding HasCurrent, Converter={StaticResource InverseBoolVisibility}}">
                    <TextBlock Text="閉じる" />
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FocusHintStyle}"
                               Visibility="{Binding HasCurrent, Converter={StaticResource BoolVisibility}}"><Run FontFamily="{StaticResource KeyCapFontFamily}" FontWeight="SemiBold" Text="Space" /><Run Text=" 完了" /></TextBlock>
                    <TextBlock Style="{StaticResource FocusHintStyle}"
                               Visibility="{Binding HasCurrent, Converter={StaticResource BoolVisibility}}"><Run FontFamily="{StaticResource KeyCapFontFamily}" FontWeight="SemiBold" Text="→" /><Run Text=" 次へ" /></TextBlock>
                    <TextBlock Style="{StaticResource FocusHintStyle}"
                               Visibility="{Binding CanUndo, Converter={StaticResource BoolVisibility}}"><Run FontFamily="{StaticResource KeyCapFontFamily}" FontWeight="SemiBold" Text="Ctrl+Z" /><Run Text=" 戻す" /></TextBlock>
                    <TextBlock Style="{StaticResource FocusHintStyle}"><Run FontFamily="{StaticResource KeyCapFontFamily}" FontWeight="SemiBold" Text="Esc" /><Run Text=" 戻る" /></TextBlock>
                </StackPanel>
                <TextBlock Style="{StaticResource FocusTextStyle}"
                           Margin="16,0,0,0"
                           FontSize="{StaticResource TypeCaptionSize}"
                           Opacity="0.5"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="FocusNotice"
                           Text="{Binding Notice}" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
