<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:settings="clr-namespace:TaskDeck.App.Settings">
    <!--
        設定画面の共通スタイル（UI 設計書 17章）。担当: 波1-D。
        各ページ（Settings/Pages/*Page.xaml）がこの辞書をマージして使う（App.xaml には足さない）。
    -->

    <!-- セクション見出し（12px SemiBold、Text.Secondary） -->
    <Style x:Key="SettingsSectionStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBaseStyle}">
        <Setter Property="FontSize" Value="{StaticResource TypeCaptionSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>

    <!-- ページ見出し（22px） -->
    <Style x:Key="SettingsTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TextTitleStyle}">
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- カード内の右側に置くラベル（「オン」「オフ」） -->
    <Style x:Key="SettingsValueStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBaseStyle}">
        <Setter Property="FontSize" Value="{StaticResource TypeLabelSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- 設定カード本体 -->
    <Style TargetType="{x:Type settings:SettingsCard}">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type settings:SettingsCard}">
                    <Border Background="{DynamicResource SettingsCardBrush}"
                            BorderBrush="{DynamicResource StrokeDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusRow}"
                            SnapsToDevicePixels="True">
                        <StackPanel>
                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Width="20" Height="20"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stroke="{DynamicResource TextPrimaryBrush}"
                                      Data="{TemplateBinding Icon}" />
                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource AppFontFamily}"
                                               FontSize="{StaticResource TypeBodySmallSize}"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               Text="{TemplateBinding Title}" />
                                    <TextBlock x:Name="DescriptionText"
                                               Margin="0,1,0,0"
                                               FontFamily="{StaticResource AppFontFamily}"
                                               FontSize="{StaticResource TypeLabelSize}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Text="{TemplateBinding Description}" />
                                </StackPanel>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                            </Grid>
                            <!-- 展開する中身が Collapsed なら、余白ごと隠す（アクセントを Windows に合わせている間の色見本など） -->
                            <ContentPresenter x:Name="ExpandedArea"
                                              Margin="50,0,16,14"
                                              Content="{TemplateBinding Expanded}"
                                              Visibility="{Binding Expanded.Visibility, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=Visible}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Expanded" Value="{x:Null}">
                            <Setter TargetName="ExpandedArea" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        設定画面のトグル（WPF-UI の ToggleSwitch。幅40×高さ20、オンは地アクセント＋ノブ右、オフは枠線のみ＋ノブ左。
        色は Themes/*.xaml の ToggleSwitch* キーでトークンに合わせてある）。状態を文字でも出す（色だけに頼らない）。
    -->
    <Style TargetType="{x:Type ui:ToggleSwitch}" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="OnContent" Value="オン" />
        <Setter Property="OffContent" Value="オフ" />
        <Setter Property="FontSize" Value="{StaticResource TypeCaptionSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- 「このバックアップから復元」などの小さいボタン -->
    <Style x:Key="SettingsButtonStyle" TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ToolbarButtonHeight}" />
        <Setter Property="FontSize" Value="{StaticResource TypeCaptionSize}" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- 画面下部・ページ内の注意書き -->
    <Style x:Key="SettingsNoticeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceSelectedStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusRow}" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,18,0,0" />
    </Style>

    <Style x:Key="SettingsNoticeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBaseStyle}">
        <Setter Property="FontSize" Value="{StaticResource TypeCaptionSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
    </Style>

    <!-- 等幅で出す値（保存先のパス・バージョン） -->
    <Style x:Key="SettingsMonoStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBaseStyle}">
        <Setter Property="FontFamily" Value="{StaticResource KeyCapFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeLabelSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 左カテゴリの項目（選択中は地 Nav.Selected ＋左端に 3×18 のアクセント縦バー）。上下のパネルをまたいで1つだけ選ばれるよう GroupName をそろえる -->
    <Style TargetType="{x:Type settings:SettingsNavItem}">
        <Setter Property="GroupName" Value="SettingsNavigation" />
        <Setter Property="Height" Value="{StaticResource SettingsNavItemHeight}" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type settings:SettingsNavItem}">
                    <Grid>
                        <Border x:Name="Row"
                                Background="Transparent"
                                CornerRadius="{StaticResource RadiusRow}"
                                SnapsToDevicePixels="True" />
                        <Border x:Name="Bar"
                                Width="3" Height="18"
                                HorizontalAlignment="Left"
                                CornerRadius="2"
                                Background="{DynamicResource AccentDefaultBrush}"
                                Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Margin="14,0,10,0" VerticalAlignment="Center">
                            <Path x:Name="Glyph"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stroke="{DynamicResource TextPrimaryBrush}"
                                  Data="{TemplateBinding Icon}" />
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource AccentDefaultBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ショートカットのキー表示 -->
    <Style x:Key="KeyCapStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeControlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
