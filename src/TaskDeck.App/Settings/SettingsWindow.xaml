<ui:FluentWindow x:Class="TaskDeck.App.Settings.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:settings="clr-namespace:TaskDeck.App.Settings"
                 Title="設定"
                 Width="1000" Height="760"
                 MinWidth="760" MinHeight="520"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 Background="{DynamicResource SurfaceWindowBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}">
    <!-- 設定（S-03、UI 設計書 17章、モックアップ Settings.dc.html）。左にカテゴリ（220）、右に設定カード。保存ボタンは置かない -->
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="設定" ShowMaximize="False" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding Source={StaticResource SettingsNavWidth}}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左: カテゴリ（同期は出さない。上下2つのパネルに分かれていても GroupName で1つだけ選ばれる） -->
            <DockPanel Margin="8,0,8,12" LastChildFill="False" KeyboardNavigation.DirectionalNavigation="Contained">
                <StackPanel x:Name="NavTop" DockPanel.Dock="Top">
                    <settings:SettingsNavItem Tag="general" Content="全般" Icon="{StaticResource IconMonitor}" Checked="OnNavChecked" />
                    <settings:SettingsNavItem Tag="appearance" Content="外観" Icon="{StaticResource IconTheme}" Checked="OnNavChecked" />
                    <settings:SettingsNavItem Tag="notifications" Content="通知" Icon="{StaticResource IconBell}" Checked="OnNavChecked" />
                    <settings:SettingsNavItem Tag="shortcuts" Content="ショートカット" Icon="{StaticResource IconKeyboard}" Checked="OnNavChecked" />
                    <settings:SettingsNavItem Tag="external" Content="外部サービス" Icon="{StaticResource IconSync}" Checked="OnNavChecked" />
                    <settings:SettingsNavItem Tag="data" Content="データ" Icon="{StaticResource IconDatabase}" Checked="OnNavChecked" />
                </StackPanel>
                <StackPanel x:Name="NavBottom" DockPanel.Dock="Bottom">
                    <settings:SettingsNavItem Tag="about" Content="TaskDeck について" Icon="{StaticResource IconInfo}" Checked="OnNavChecked" />
                </StackPanel>
            </DockPanel>

            <!-- 右: 設定カード -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SurfaceContentBrush}"
                    BorderBrush="{DynamicResource StrokeDividerBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="{StaticResource RadiusContentTopLeft}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ページの中の一覧は数件だけ（仮想化が要らない）なので、ページごとスクロールさせる -->
                    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" Padding="26,22,26,0">
                        <!-- カードは幅いっぱいに広げ、広すぎるときは左に寄せて最大幅で止める -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="{StaticResource SettingsCardMaxWidth}" />
                            </Grid.ColumnDefinitions>
                            <ContentControl x:Name="PageHost" Focusable="False" IsTabStop="False" />
                        </Grid>
                    </ScrollViewer>

                    <!-- 保存ボタンを置かない代わりの案内（UI 設計書 17章） -->
                    <Border Grid.Row="1" Style="{StaticResource SettingsNoticeStyle}" Margin="26,14,26,20">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16"
                                  Stretch="Uniform"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeLineJoin="Round"
                                  VerticalAlignment="Top"
                                  Margin="0,1,0,0"
                                  Stroke="{DynamicResource AccentDefaultBrush}"
                                  Data="{StaticResource IconInfo}" />
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Style="{StaticResource SettingsNoticeTextStyle}"
                                           Text="変更はすぐに反映されます。保存ボタンはありません。" />
                                <TextBlock x:Name="SettingsPathText"
                                           Style="{StaticResource SettingsMonoStyle}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
