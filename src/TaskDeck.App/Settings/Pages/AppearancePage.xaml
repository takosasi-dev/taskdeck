<UserControl x:Class="TaskDeck.App.Settings.Pages.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:settings="clr-namespace:TaskDeck.App.Settings"
             xmlns:pk="clr-namespace:TaskDeck.App.Controls.Pickers">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <pk:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- 配色の選択カード（見本＋ラジオ） -->
            <Style x:Key="ThemeChoiceStyle" TargetType="RadioButton">
                <Setter Property="Width" Value="150" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource TypeCaptionSize}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Frame"
                                    Background="{DynamicResource SurfaceContentBrush}"
                                    BorderBrush="{DynamicResource StrokeControlBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8"
                                    SnapsToDevicePixels="True">
                                <StackPanel>
                                    <ContentPresenter />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Grid Width="14" Height="14" VerticalAlignment="Center">
                                            <Ellipse x:Name="Ring"
                                                     Stroke="{DynamicResource StrokeControlStrongBrush}"
                                                     StrokeThickness="1"
                                                     Fill="{DynamicResource SurfaceContentBrush}" />
                                            <Ellipse x:Name="Dot" Width="6" Height="6"
                                                     Fill="{DynamicResource TextOnAccentBrush}"
                                                     Visibility="Collapsed" />
                                        </Grid>
                                        <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="{TemplateBinding Tag}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource StrokeControlStrongBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}" />
                                    <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                                    <Setter TargetName="Frame" Property="Padding" Value="7" />
                                    <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource AccentDefaultBrush}" />
                                    <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentDefaultBrush}" />
                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                    <Setter Property="FontWeight" Value="Medium" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 見本の中の小さな帯 -->
            <Style x:Key="SampleBarStyle" TargetType="Border">
                <Setter Property="Height" Value="5" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <!-- アクセント色の見本（26×26。選んでいる色に Text.OnAccent のチェック） -->
            <Style x:Key="SwatchStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource StrokeControlBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource SettingsTitleStyle}" Text="外観" />

        <TextBlock Style="{StaticResource SettingsSectionStyle}" Margin="0,4,0,8" Text="テーマ" />

        <!-- 配色の見本はテーマに関わらず同じ絵（ライト・ダークそのものの色を見せるため、ここだけ色を直接書く） -->
        <settings:SettingsCard Icon="{StaticResource IconTheme}"
                               Title="配色"
                               Description="ウィンドウ全体の明るさを選びます。「Windows に合わせる」なら Windows の設定を変えたときに一緒に切り替わります">
            <settings:SettingsCard.Expanded>
                <StackPanel Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Contained">
                    <RadioButton Style="{StaticResource ThemeChoiceStyle}" GroupName="theme" Tag="ライト"
                                 IsChecked="{Binding IsThemeLight}" AutomationProperties.Name="配色をライトにする">
                        <Border Height="54" CornerRadius="4" Background="#FFF3F3F3" BorderBrush="#FFD6D6D6" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="4,5">
                                    <Border Style="{StaticResource SampleBarStyle}" Background="#FFC8C8C8" />
                                    <Border Style="{StaticResource SampleBarStyle}" Background="#FFDCDCDC" />
                                    <Border Style="{StaticResource SampleBarStyle}" Background="#FFDCDCDC" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#FFFFFFFF" CornerRadius="4">
                                    <StackPanel Margin="5,5">
                                        <Border Style="{StaticResource SampleBarStyle}" Background="#FFC8C8C8" Width="60" HorizontalAlignment="Left" />
                                        <Border Style="{StaticResource SampleBarStyle}" Background="#FFE6E6E6" />
                                        <Border Style="{StaticResource SampleBarStyle}" Background="#FFE6E6E6" Width="70" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ThemeChoiceStyle}" GroupName="theme" Tag="ダーク"
                                 IsChecked="{Binding IsThemeDark}" AutomationProperties.Name="配色をダークにする">
                        <Border Height="54" CornerRadius="4" Background="#FF202020" BorderBrush="#FF3D3D3D" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="4,5">
                                    <Border Style="{StaticResource SampleBarStyle}" Background="#FF5A5A5A" />
                                    <Border Style="{StaticResource SampleBarStyle}" Background="#FF3D3D3D" />
                                    <Border Style="{StaticResource SampleBarStyle}" Background="#FF3D3D3D" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#FF272727" CornerRadius="4">
                                    <StackPanel Margin="5,5">
                                        <Border Style="{StaticResource SampleBarStyle}" Background="#FF5A5A5A" Width="60" HorizontalAlignment="Left" />
                                        <Border Style="{StaticResource SampleBarStyle}" Background="#FF3A3A3A" />
                                        <Border Style="{StaticResource SampleBarStyle}" Background="#FF3A3A3A" Width="70" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ThemeChoiceStyle}" GroupName="theme" Tag="Windows に合わせる"
                                 IsChecked="{Binding IsThemeSystem}" AutomationProperties.Name="配色を Windows に合わせる">
                        <Border Height="54" CornerRadius="4" BorderBrush="#FFD6D6D6" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#FFF3F3F3" CornerRadius="3,0,0,3">
                                    <StackPanel Margin="4,5">
                                        <Border Style="{StaticResource SampleBarStyle}" Background="#FFC8C8C8" />
                                        <Border Style="{StaticResource SampleBarStyle}" Background="#FFDCDCDC" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#FF272727" CornerRadius="0,3,3,0">
                                    <StackPanel Margin="4,5">
                                        <Border Style="{StaticResource SampleBarStyle}" Background="#FF5A5A5A" />
                                        <Border Style="{StaticResource SampleBarStyle}" Background="#FF3A3A3A" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </RadioButton>
                </StackPanel>
            </settings:SettingsCard.Expanded>
        </settings:SettingsCard>

        <settings:SettingsCard Icon="{StaticResource IconPalette}"
                               Title="アクセントカラー"
                               Description="{Binding AccentDescription}">
            <StackPanel Orientation="Horizontal">
                <!-- いま使っている色（システムの色でも固定色でも、実際に画面に出ている色） -->
                <Border Width="22" Height="22" Margin="0,0,12,0"
                        CornerRadius="4"
                        Background="{DynamicResource AccentDefaultBrush}"
                        BorderBrush="{DynamicResource StrokeControlBrush}"
                        BorderThickness="1"
                        AutomationProperties.Name="いまのアクセントカラー" />
                <TextBlock Style="{StaticResource SettingsValueStyle}" Text="Windows に合わせる" />
                <ui:ToggleSwitch IsChecked="{Binding UseSystemAccent}"
                                 AutomationProperties.Name="アクセントカラーを Windows に合わせる" />
            </StackPanel>
            <settings:SettingsCard.Expanded>
                <ItemsControl ItemsSource="{Binding AccentSwatches}"
                              Focusable="False"
                              Visibility="{Binding UseSystemAccent, Converter={StaticResource EqualsToVisibility}, ConverterParameter=False}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SwatchStyle}"
                                    Background="{Binding DisplayHex}"
                                    Command="{Binding DataContext.PickAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Hex}"
                                    AutomationProperties.Name="{Binding Name, StringFormat='アクセントカラーを{0}にする'}"
                                    ToolTip="{Binding Name}">
                                <Path Width="13" Height="13"
                                      Stretch="Uniform"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stroke="{DynamicResource TextOnAccentBrush}"
                                      Data="{StaticResource IconCheck}"
                                      Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </settings:SettingsCard.Expanded>
        </settings:SettingsCard>

        <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="表示" />

        <settings:SettingsCard Icon="{StaticResource IconList}"
                               Title="行の高さ"
                               Description="1画面に入るタスクの件数が変わります">
            <ComboBox Style="{StaticResource SettingsComboBoxStyle}"
                      Width="170"
                      ItemsSource="{Binding RowHeightChoices}"
                      SelectedIndex="{Binding RowHeightIndex}"
                      AutomationProperties.Name="行の高さ" />
        </settings:SettingsCard>

        <settings:SettingsCard Icon="{StaticResource IconActivity}"
                               Title="アニメーションを減らす"
                               Description="{Binding ReduceMotionDescription}">
            <ComboBox Style="{StaticResource SettingsComboBoxStyle}"
                      Width="200"
                      ItemsSource="{Binding ReduceMotionChoices}"
                      SelectedIndex="{Binding ReduceMotionIndex}"
                      AutomationProperties.Name="アニメーションを減らす" />
        </settings:SettingsCard>

        <settings:SettingsCard Icon="{StaticResource IconSidebar}"
                               Title="詳細ペインを自動で開く"
                               Description="タスクを選んだときに右側を表示します">
            <ui:ToggleSwitch IsChecked="{Binding AutoShowDetailPane}"
                             AutomationProperties.Name="詳細ペインを自動で開く" />
        </settings:SettingsCard>
    </StackPanel>
</UserControl>
